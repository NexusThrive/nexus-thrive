# ============================================================================
# NEXUS THRIVE · Variables de PRODUCCIÓN (Vercel)
# ============================================================================
# Copia estos valores en Vercel → Settings → Environment Variables → Production.
# Las marcadas como OBLIGATORIA hay que tenerlas sí o sí; las demás la app
# degrada con elegancia si no están (se puede dejar para más adelante).
#
# Después de cambiarlas: Redeploy (obligatorio; las variables NEXT_PUBLIC_* se
# compilan en el build).
# ============================================================================

# ============================ OBLIGATORIAS ============================

# Conexión a PostgreSQL (Supabase). OJO: la URL del pooler NO acepta
# parámetros de query; la de conexión directa sí.
DATABASE_URL=

# Clerk, instancia de PRODUCCIÓN (pk_live_ / sk_live_). Cambiar el dominio de
# la app genera una key nueva: hay que volver a copiarla aquí.
# Ver docs/clerk-produccion.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# URL pública de la app. Sin esto, los enlaces compartidos (QR de las
# tarjetas, recibos, cotizaciones) se arman con el host de la petición, y
# desde un proceso sin petición (jobs, WhatsApp) caen a localhost.
NEXT_PUBLIC_APP_URL=https://app.nexusthrive.com.co

# Rutas de acceso (relativas: la app vive en el subdominio `app`).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ============================ RECOMENDADAS ============================

# Firma de los recibos públicos (/r/...). Cualquier frase larga y aleatoria.
# Si no se pone, se usa CLERK_SECRET_KEY.
RECEIPT_LINK_SECRET=

# WhatsApp de NEXUS: se muestra en el botón "Coordinar pago" del onboarding.
# Por defecto 573237453913.
NEXT_PUBLIC_NEXUS_WHATSAPP=

# ============================ OPCIONALES ============================
# (la app funciona sin ellas; cada una habilita una función)

# Vercel Blob: subida de archivos grandes (fotos, adjuntos, catálogo APU).
BLOB_READ_WRITE_TOKEN=

# WhatsApp de cada negocio + bandeja de NEXUS (Meta). Sin esto, la bandeja y
# el botón "Conecta tu WhatsApp" quedan inactivos.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
META_APP_ID=
META_CONFIG_ID=

# Correo saliente y entrante (Resend).
RESEND_API_KEY=
INBOX_EMAIL_FROM=
INBOUND_EMAIL_SECRET=

# Google Places: autocompletado de direcciones en el onboarding.
GOOGLE_PLACES_API_KEY=

# ============================ PLAN B: PROXY DE CLERK ============================
# Si el host de Clerk no es alcanzable, se sirve el script de ClerkJS desde el
# propio dominio. Antes de activarlo, en Clerk → Dominios → Frontend API →
# "Set proxy configuration" → https://app.nexusthrive.com.co/__clerk
# NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk
