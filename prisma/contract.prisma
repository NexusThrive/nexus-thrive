// use prisma-8

enum Role {
  SUPERADMIN
  OWNER
  STAFF
  /// Equipo del negocio (fase V1): administración, recepción y asesores.
  ADMIN
  RECEPTION
  ADVISOR
}

/// Etapa comercial de una cuenta en el Operations Center. Distinta del
/// estado de servicio (`Tenant.active` + `suspendedReason`): un problema de
/// pago o técnico no es una cancelación comercial.
/// Embudo comercial de NEXUS (Operations Center · CRM).
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  DEMO
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Suscripción de un negocio a NEXUS THRIVE (Operations Center · Facturación).
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

/// Vencido no es un estado: se calcula con la fecha de vencimiento.
enum ChargeStatus {
  PENDING
  PAID
  VOID
  REFUNDED
}

/// Bandeja de NEXUS (canales propios con los negocios).
enum InboxChannel {
  WHATSAPP
  EMAIL
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

/// Movimientos de la caja menor.
enum CashMovementKind {
  OPENING
  INCOME
  EXPENSE
  VOUCHER
  REPLENISH
  ADJUST
}

/// Tipo de código de acceso: `PROMO` es un regalo (cortesía/promoción) y `PAID`
/// es un acceso pagado que NEXUS emite tras confirmar el pago. Cambia el texto
/// que ve la persona ("gratis" vs "cuenta activada"), no el canje.
enum BenefitKind {
  PROMO
  PAID
}

/// Qué vende el negocio: producto con stock, servicio con duración, plan de
/// membresía, entrada de museo o tour/paquete.
enum ProductKind {
  PRODUCT
  SERVICE
  PLAN
  TICKET
  TOUR
}

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

enum AccountStage {
  ONBOARDING
  ACTIVE
  CANCELLED
  ARCHIVED
}

/// Plan de NEXUS elegido en el onboarding (Thrive Essential / Elite / Signature).
enum TenantPlan {
  /// Gratis: módulos base para conocer NEXUS.
  ESSENTIAL
  /// Módulos a la medida del negocio.
  ELITE
  /// Todos los módulos del rubro con acompañamiento.
  SIGNATURE
}

/// Ciclo de facturación del plan.
enum BillingCycle {
  MONTHLY
  ANNUAL
}

/// Perfil del negocio en el onboarding auto-servicio: persona natural vs empresa.
enum TenantType {
  /// Emprendedor / persona natural (perfil liviano: sin NIT obligatorio).
  INDIVIDUAL
  /// Empresa / negocio establecido (perfil completo: NIT, tamaño, dirección).
  COMPANY
}

enum Vertical {
  gym
  tourism_agency
  hospitality
  construction
  carpentry
  restaurant
  retail
  beauty
  healthcare
  mechanic
  education
  real_estate
  hardware_store
  nautical_transport
  tour_guides
  events
  museum
  /// Perfil general: agencia, consultora, empresa B2B, emprendimiento o negocio mixto. No exige un rubro.
  general
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
}

enum PaymentProvider {
  WOMPI
  NEQUI
  CASH
  TRANSFER
}

enum MembershipType {
  mensual
  trimestral
  anual
}

enum MembershipStatus {
  active
  expiring
  expired
}

/// Categoría de un insumo del banco APU (Análisis de Precios Unitarios).
enum ApuItemCategory {
  MATERIAL
  MANO_DE_OBRA
  EQUIPO
  TRANSPORTE
  /// Otros costos (secciones "OTROS" del pack APU).
  OTRO
  /// Subcontratos (sección "SUBCONTRATOS" del pack APU).
  SUBCONTRATO
}

/// Origen de una línea de composición APU: importada de un archivo (se
/// reemplaza al reimportar) o creada a mano (nunca la toca una importación).
enum CompositionOrigin {
  IMPORT
  MANUAL
}

/// Estado de un presupuesto/cotización de obra.
enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  /// Reemplazada por una versión posterior de la misma obra.
  SUPERSEDED
}

/// Tipo de seguimiento comercial de una obra (carpeta de cotizaciones).
enum FollowUpType {
  NOTE
  CALL
  EMAIL
  MEETING
  VISIT
}

/// Ciclo de vida de un proyecto de obra (vertical construcción).
enum ProjectStatus {
  DRAFT
  BIDDING
  APPROVED
  IN_EXECUTION
  COMPLETED
  CANCELLED
}

/// Categoría de un recurso que compone la actividad (APU) de una partida
/// presupuestaria (FASE 2 — Tab 2). Distinto de `ApuItemCategory` (banco de
/// insumos reutilizable): aquí es la clasificación dentro de un presupuesto.
enum ResourceType {
  MATERIAL
  LABOR
  EQUIPMENT
  TRANSPORT
  OTHER
  SUBCONTRACT
}

/// Resultado evaluado de un compromiso semanal (Last Planner System). No
/// representa el avance de una tarea: es el resultado del compromiso de la
/// semana — pendiente de evaluar, cumplido o no cumplido (FASE 3 — Tab 3).
enum CommitmentStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Causa de No Cumplimiento (CNC) de un compromiso fallido. Catálogo base
/// del sistema CNC (Last Planner System).
enum NonComplianceCause {
  WEATHER
  MATERIALS
  LABOR
  EQUIPMENT
  DESIGN_CHANGE
  PREVIOUS_WORK
  OTHER
}

/// Tipo de anotación en la bitácora de campo (FASE 4 — Tab 4).
enum FieldNoteType {
  ADVANCE
  OBSERVATION
  AUTHORIZATION
  INCIDENT
}

/// Condición meteorológica registrada en una anotación de campo (FASE 4 — Tab 4).
enum WeatherCondition {
  SUNNY
  CLOUDY
  RAIN_LIGHT
  RAIN_HEAVY
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  vertical     Vertical
  active       Boolean  @default(true)

  /// Wizard de onboarding: false = el tenant es nuevo y debe configurarse.
  onboardingCompleted Boolean @default(false)
  /// Perfil adaptativo (onboarding auto-servicio). Las reglas de validación
  /// viven en lib/onboarding/validation.ts; estos campos son la persistencia.
  tenantType TenantType @default(COMPANY)
  /// Razón social (solo COMPANY; el nombre comercial vive en `name`).
  legalName String?
  /// NIT/RUT (obligatorio en COMPANY, opcional en INDIVIDUAL).
  taxId String?
  /// Tamaño del equipo: "SOLO" | "2-5" | "6-20" | "20+" (guardado como texto
  /// validado por la app; el enum rígido dificultaría agregar rangos).
  teamSize String?
  /// Dirección física; "REMOTE" si el negocio no tiene local.
  address String?
  /// Coordenadas confirmadas con Google Places durante el onboarding
  /// (opcionales: si no se confirmó la ubicación, quedan en null).
  latitude  Float?
  longitude Float?
  /// `place_id` de Google Places, para refrescar/ubicar el local luego.
  placeId String?
  /// Identidad y ubicación (Paso 1 del onboarding).
  city              String?
  whatsappNumber    String?
  /// Ecosistema digital (Paso 3 del onboarding).
  websiteUrl        String?
  instagramHandle   String?
  googleBusinessUrl String?
  /// Plan elegido en el onboarding. Aún no hay cobro: se guarda la elección y
  /// el precio que se le mostró (calculado en el servidor con lib/plans).
  plan                TenantPlan   @default(ESSENTIAL)
  billingCycle        BillingCycle @default(MONTHLY)
  /// Precio mensual en centavos de USD (0 en Essential).
  planMonthlyUsdCents Int          @default(0)
  planSelectedAt      DateTime?
  /// Tramo de clientes elegido (CustomerTierSetting.id) y módulos contratados
  /// con el plan. "Contratado" ≠ "habilitado" (TenantModule) ≠ "operativo"
  /// (ModuleSetting.status).
  customerTierId    String?
  contractedModules String[]?
  /// Límites acordados en un código a medida (null = los del plan).
  maxUsers          Int?
  maxCustomers      Int?
  /// Método de costeo del inventario. Hoy solo AVG (promedio ponderado); FIFO llegará después.
  costingMethod     String   @default("AVG")
  /// Modelo comercial (contexto, no restricción): B2B | B2C | B2B2C. Vacío = sin definir.
  businessModels    String[]?
  /// Qué hace el negocio, en sus palabras (contexto para recomendaciones).
  activity          String?
  /// Operations Center: etapa comercial y responsable de cuenta (StaffMember.id).
  accountStage     AccountStage @default(ACTIVE)
  accountManagerId String?
  /// Métodos de pago aceptados (Paso 4 del onboarding; catálogo PaymentProvider).
  /// Nullable en DB: un tenant nuevo aún no los configuró; el código normaliza a [].
  paymentMethods    PaymentProvider[]?

  /// Suspensión administrativa (Panel CEO): motivo obligatorio + timestamp.
  /// Se conserva aunque el tenant se reactive (historial de por qué se suspendió).
  suspendedReason String?
  suspendedAt     DateTime?

  /// Ajustes operativos del rubro (aforo del museo, franjas, horarios…).
  settings          Json?
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  users         User[]
  customers     Customer[]
  payments      Payment[]
  expenses      Expense[]
  memberships   Membership[]
  modules       TenantModule[]
  customerNotes CustomerNote[]
  apuItems      ApuItem[]
  apuActivities ApuActivity[]
  apuImages     ApuImage[]
  apuChapters   ApuChapter[]
  apuImportRuns ApuImportRun[]
  apuPriceHistory ApuItemPriceHistory[]
  quotes        Quote[]
  projectFollowUps ProjectFollowUp[]
  budgetItemProgress BudgetItemProgress[]
  projects      Project[]
  projectBudgets ProjectBudget[]
  budgetChapters BudgetChapter[]
  budgetItems   BudgetItem[]
  budgetItemResources BudgetItemResource[]
  budgetBaselines   BudgetBaseline[]
  projectPlans      ProjectPlan[]
  lookaheadTasks    LookaheadTask[]
  weeklyCommitments WeeklyCommitment[]
  fieldLogs         FieldLog[]
  presenceScans     PresenceScan[]
  bookings           Booking[]
  contacts           TenantContact[]
  leads              Lead[]
  apiKeys            ApiKey[]
  apiRequestLogs     ApiRequestLog[]
  idempotencyRecords IdempotencyRecord[]
  outboxEvents       OutboxEvent[]
  webhookEndpoints   WebhookEndpoint[]
  webhookDeliveries  WebhookDelivery[]
  usageCounters      UsageCounter[]
  externalConnections ExternalConnection[]
  providerEvents     ProviderEvent[]
  parties            Party[]
  partyRoles         PartyRole[]
  productVariants    ProductVariant[]
  productBarcodes    ProductBarcode[]
  priceLists         PriceList[]
  priceListItems     PriceListItem[]
  warehouses         Warehouse[]
  stockLevels        StockLevel[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  supplierInvoices   SupplierInvoice[]
  supportTickets     SupportTicket[]
  charges            Charge[]
  benefitRedemptions BenefitRedemption[]
  inboxConversations InboxConversation[]
  satisfactionSurveys SatisfactionSurvey[]
  attachments        Attachment[]
  cashBoxes          CashBox[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  products           Product[]
  stockMovements     StockMovement[]
  invoices           Invoice[]
  invites            TenantInvite[]
  attendances        Attendance[]
  ticketSales        TicketSale[]
  departures         Departure[]
  tourBookings       TourBooking[]
  presenceRequests   PresenceRequest[]
  subscription       Subscription?

  @@index([slug])
  @@rls
}

model TenantModule {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Id de la capacidad (lib/capabilities/registry.ts). Texto validado en el
  /// servidor con `isModule`: agregar un módulo no necesita migración.
  moduleName String
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  temporal.updatedAt()

  @@unique([tenantId, moduleName])
  @@index([tenantId])
  @@rls
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String
  email       String
  name        String?
  role        Role     @default(STAFF)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Retirado del negocio: conserva su historial pero ya no entra.
  active      Boolean  @default(true)
  phone       String?
  title       String?
  /// Tema elegido (light | dark), guardado en la cuenta.
  theme       String?
  removedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  customerNotes CustomerNote[]

  @@unique([clerkUserId, tenantId])
  @@index([tenantId])
  @@rls
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  documentId String?
  birthDate  DateTime?
  tags       String[]?
  /// Campos propios del rubro (gym: peso, talla, objetivo…; turismo: pasaporte…).
  profile    Json?
  /// Foto (Attachment.id, kind CUSTOMER_PHOTO).
  photoId    String?
  city       String?
  /// Código de acceso (QR) y tarjeta NFC vinculada.
  accessCode String?
  nfcUid     String?
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  payments Payment[]
  memberships Membership[]
  notes CustomerNote[]
  quotes Quote[]
  projects Project[]
  /// Tercero único al que pertenece este cliente (la misma persona o empresa, con sus roles).
  partyId  String?
  party    Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([partyId])
  /// Un código o una tarjeta identifica a UN socio del negocio (DATA-04).
  @@index([tenantId, accessCode], unique: true, where: "\"accessCode\" IS NOT NULL", name: "Customer_tenantId_accessCode_key")
  @@index([tenantId, nfcUid], unique: true, where: "\"nfcUid\" IS NOT NULL", name: "Customer_tenantId_nfcUid_key")
  @@rls
}

model Payment {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  membershipId  String?
  membership    Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amount        Decimal
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(CASH)
  providerRefId String?         @unique
  description   String?
  /// Recibo consecutivo del negocio (R-000123).
  receiptNumber Int?
  /// Anulación con motivo (el pago no se borra).
  voidedAt      DateTime?
  voidReason    String?
  notes         String?
  /// Qué pagó: MEMBERSHIP, INVOICE, TOUR_BOOKING, TICKET_SALE, PROJECT, SALE.
  sourceType    String?
  sourceId      String?
  /// Sesión de caja en la que entró (si fue en efectivo).
  cashSessionId String?
  invoiceId     String?
  createdAt     DateTime        @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([providerRefId])
  @@index([membershipId])
  @@unique([tenantId, receiptNumber])
  @@rls
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String
  description String
  date        DateTime @default(now())
  supplier      String?
  /// CASH (caja menor) | BANK | CARD
  paidFrom      String    @default("BANK")
  voidedAt      DateTime?
  voidReason    String?
  cashSessionId String?
  /// Obra a la que se carga el gasto (constructoras).
  projectId     String?
  createdById   String?
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
  @@rls
}

model Membership {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       MembershipType
  startDate  DateTime
  endDate    DateTime
  status     MembershipStatus @default(active)
  price      Decimal
  charges    Payment[]
  /// Plan del catálogo con el que se vendió.
  productId    String?
  frozenFrom   DateTime?
  frozenUntil  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt  DateTime         @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([tenantId, endDate])
  @@index([customerId])
  @@rls
}

/// Observación interna sobre un cliente (Ficha 360°). Sin módulo propio:
/// pertenece al núcleo del CRM.
model CustomerNote {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  /// User.id del autor (se conserva el contenido si el usuario se elimina).
  createdBy  String?
  author     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([customerId])
  @@rls
}

/// Insumo/recurso básico del banco APU (material, mano de obra, equipo o
/// transporte). El `code` es opcional pero único DENTRO del tenant cuando existe.
model ApuItem {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String?
  name      String
  unit      String
  category  ApuItemCategory
  unitPrice Decimal
  /// Etapa 2: campos aditivos (no rompen datos existentes).
  active    Boolean        @default(true)
  /// Enlace externo heredado. Las imágenes importadas van en `imageId`.
  imageUrl  String?
  /// Imagen guardada en el sistema (importada del Excel o subida).
  imageId   String?
  image     ApuImage?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// Identidad estable para reimportar sin duplicar: descripción + unidad
  /// normalizadas. Null en insumos creados a mano.
  sourceKey String?
  /// Si el insumo es un APU auxiliar (APU compuesto), la actividad que lo define.
  auxiliaryActivityId String?
  auxiliaryActivity   ApuActivity? @relation("ApuAuxiliaryItem", fields: [auxiliaryActivityId], references: [id], onDelete: SetNull)
  /// Última importación que tocó el insumo.
  importedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt temporal.updatedAt()

  compositions ApuActivityComposition[]
  priceHistory ApuItemPriceHistory[]

  @@unique([tenantId, code])
  @@unique([tenantId, sourceKey])
  @@index([tenantId])
  @@rls
}

/// Imagen binaria de un insumo, guardada en la base (no es un enlace
/// externo). Deduplicada por contenido dentro del tenant: reimportar la misma
/// foto no la duplica.
model ApuImage {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sha256    String
  mimeType  String
  byteSize  Int
  data      Bytes
  createdAt DateTime @default(now())

  items     ApuItem[]

  @@unique([tenantId, sha256])
  @@index([tenantId])
  @@rls
}

/// Capítulo del catálogo APU (ej. "1 PRELIMINARES"). Ordena las actividades.
model ApuChapter {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  /// Capítulo padre de un subcapítulo ("22" para "22.63").
  parentCode String?
  name      String
  order     Int
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  activities ApuActivity[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@rls
}

/// Registro de cada importación del catálogo (auditoría: qué archivo, cuándo,
/// quién y qué cambió). Nunca se borra.
model ApuImportRun {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName    String
  fileSha256  String
  importedBy  String?
  /// Conteos y verificaciones del resultado (JSON serializable).
  stats       Json
  createdAt   DateTime @default(now())

  priceChanges ApuItemPriceHistory[]

  @@index([tenantId, createdAt])
  @@rls
}

/// Historial de precios de un insumo: cada precio distinto que tuvo, con su
/// origen. Una importación que cambia un precio deja aquí el anterior y el nuevo.
model ApuItemPriceHistory {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId      String
  item        ApuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price       Decimal
  /// "IMPORT" o "MANUAL".
  source      String
  importRunId String?
  importRun   ApuImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([tenantId])
  @@rls
}

/// Actividad de obra reutilizable (ej. M2 de muro en ladrillo). Se compone
/// de insumos con rendimiento (`consumption`) y desperdicio (`wastePercent`).
model ApuActivity {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String?
  name        String
  unit        String
  description String?
  /// Etapa 2: campo aditivo (no rompe datos existentes).
  active      Boolean  @default(true)
  /// Capítulo del catálogo al que pertenece (null en auxiliares y manuales).
  chapterId   String?
  chapter     ApuChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  /// APU auxiliar: se usa como insumo de otros APU (APU compuesto).
  isAuxiliary Boolean  @default(false)
  /// Costo directo unitario declarado en el archivo importado ("VR COSTO
  /// DIRECTO"); sirve para verificar que el cálculo del sistema coincide.
  referenceUnitPrice Decimal?
  /// Clave de orden natural ("0001.0002" para 1.02) para listar como el archivo.
  sortKey     String?
  /// Datos del archivo sin columna propia (ej. "TOTAL % P" de un auxiliar de
  /// mano de obra). Se guardan tal cual para no perder nada.
  sourceExtras Json?
  /// Identidad estable para reimportar ("APU:1.01" o "AUX:<descripción>|<unidad>").
  sourceKey   String?
  importedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  compositions ApuActivityComposition[]
  quoteItems  QuoteItem[]
  auxiliaryItems ApuItem[] @relation("ApuAuxiliaryItem")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@rls
}

/// Composición de una actividad APU: insumo + rendimiento + desperdicio.
/// Se elimina en cascada con la actividad.
model ApuActivityComposition {
  id           String      @id @default(uuid())
  activityId   String
  activity     ApuActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  itemId       String
  item         ApuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Cantidad del insumo por unidad de actividad (rendimiento).
  consumption  Decimal
  /// Porcentaje de desperdicio (0–50).
  wastePercent Decimal
  /// Posición de la línea dentro del APU (orden del archivo).
  order        Int               @default(0)
  /// Sección original del archivo ("MANO de OBRA:", "SEGURIDAD SOCIAL:"…).
  section      String?
  /// Unidad tal como viene en la línea (puede ser "%MO", "%", "%S").
  lineUnit     String?
  /// Cantidad / rendimiento tal como viene en el archivo.
  lineQuantity Decimal?
  /// Precio unitario de la línea en el archivo. En líneas porcentuales es la
  /// base sobre la que se aplica el porcentaje y difiere entre actividades.
  lineUnitPrice Decimal?
  /// Valor parcial declarado en el archivo (verificación).
  linePartial  Decimal?
  origin       CompositionOrigin @default(MANUAL)

  @@index([activityId, order])
  @@index([itemId])
  @@rls
}

model Booking {
  id          String        @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  serviceName String
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(PENDING)
  totalAmount BigInt        @default(0)
  notes       String?
  /// Servicio, clase o tour del catálogo (Product).
  productId      String?
  /// Persona del equipo que atiende (User.id).
  staffUserId    String?
  partySize      Int       @default(1)
  /// APPOINTMENT | CLASS | DELIVERY | VISIT | DEPARTURE
  kind           String    @default("APPOINTMENT")
  reminderSentAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@rls
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Encabezado de un presupuesto/cotización de obra.
model Quote {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title         String
  /// Código de negocio: PRES-2026-001 (único dentro del tenant).
  code          String
  status        QuoteStatus @default(DRAFT)
  adminPercent  Decimal     @default(15)
  imprevPercent Decimal     @default(5)
  utilPercent   Decimal     @default(10)
  taxPercent    Decimal     @default(19)
  directCost    Decimal
  totalAmount   Decimal
  /// Obra de la que se emitió (null solo en cotizaciones anteriores a que la
  /// cotización naciera de la obra; ver la migración de cotizaciones antiguas).
  projectId     String?
  project       Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Versión dentro de la obra (v1, v2…).
  version       Int?
  /// Revisión del presupuesto congelada en esta versión.
  budgetRevision Int?
  /// Foto completa del documento emitido (capítulos, partidas, totales,
  /// partes). Un cambio posterior del presupuesto no la altera.
  snapshot      Json?
  /// Si el documento para el cliente muestra el detalle APU de cada partida.
  showApuDetail Boolean     @default(false)
  validUntil    DateTime?
  sentAt        DateTime?
  decidedAt     DateTime?
  decidedByName String?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     temporal.updatedAt()

  items QuoteItem[]
  followUps ProjectFollowUp[]

  @@unique([tenantId, code])
  @@unique([projectId, version])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
  @@rls
}

/// Seguimiento comercial de una obra: llamada, correo, reunión, visita o nota,
/// opcionalmente ligado a una versión de la cotización y con fecha prevista.
model ProjectFollowUp {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteId      String?
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  type         FollowUpType @default(NOTE)
  note         String
  /// Fecha prevista (próximo contacto); null si es un registro de lo ocurrido.
  scheduledFor DateTime?
  completedAt  DateTime?
  authorName   String
  createdAt    DateTime     @default(now())
  updatedAt    temporal.updatedAt()

  @@index([tenantId, projectId])
  @@index([projectId, createdAt])
  @@rls
}

/// Registro de auditoría de acciones privilegiadas del SuperAdmin
/// (suspensión, activación, módulos, exportación, impersonación). No se
/// relaciona por FK con Tenant a propósito: la auditoría debe sobrevivir al
/// borrado del negocio. NUNCA guarda secretos ni tokens.
model AuditLog {
  id         String   @id @default(uuid())
  /// Clerk user id del SuperAdmin actor (no expone datos sensibles).
  actorId    String
  actorEmail String?
  /// Acción auditada (string controlado por el código, no un enum: las
  /// migraciones de enum en Prisma 8 son frágiles y aquí no aportan valor).
  action     String
  /// Negocio objetivo (puede ser null en acciones globales como exportar).
  targetTenantId   String?
  targetTenantName String?
  /// Metadatos serializables (motivo, módulos, filas exportadas…). Sin secretos.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  /// Quién actuó: USER | API_KEY | AGENT | AUTOMATION | SYSTEM.
  actorType  String   @default("USER")
  /// Llave de API que ejecutó la acción (si fue por API/MCP).
  apiKeyId   String?
  /// Identificador de la petición (el mismo de `X-Request-Id`).
  requestId  String?

  @@index([createdAt])
  @@index([targetTenantId])
  @@index([actorId])
  @@index([apiKeyId])
  @@rls
}

/// Actividad dentro de un presupuesto. Congela nombre, unidad, cantidad y
/// costos al momento de cotizar; opcionalmente guarda el snapshot del APU.
model QuoteItem {
  id          String       @id @default(uuid())
  quoteId     String
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    ApuActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  name        String
  unit        String
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  /// Fotografía inmutable del APU utilizado (catálogo + composición + precios).
  apuSnapshot Json?

  @@index([quoteId])
  @@index([activityId])
  @@rls
}

/// Contenedor de un proyecto de obra (FASE 1 del vertical construcción).
/// Cada proyecto es dueño de su ficha (`ProjectHeader`, 1:1) y, en fases
/// posteriores, de presupuestos, planificación y bitácora.
///
/// Aislamiento multi-tenant: toda consulta filtra por `tenantId` y la capa
/// de negocio valida que el `Customer` pertenezca al mismo tenant antes de
/// vincularlo (el índice compuesto impide cruces accidentales de lectura).
model Project {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Código de negocio: PROY-2026-001 (único dentro del tenant).
  code       String
  name       String
  description String?
  status     ProjectStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  temporal.updatedAt()

  header   ProjectHeader?
  /// Presupuesto de obra del proyecto (1:1 en esta fase, Tab 2).
  budget   ProjectBudget?
  quotes   Quote[]
  followUps ProjectFollowUp[]
  /// Plan operativo Lean (Last Planner System) del proyecto (1:1, Tab 3).
  plan     ProjectPlan?
  /// Bitácora de campo del proyecto (1:1, Tab 4).
  fieldLog FieldLog?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@rls
}

/// 1:1 con Proyecto. Snapshot inicial tomado del Customer del CRM al crear
/// el proyecto (no es una segunda fuente maestra de cliente: el maestro
/// sigue siendo `Customer`; aquí se congela lo que aplica a ESTA obra).
model ProjectHeader {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // A) Datos tributarios / contractuales del cliente (snapshot del CRM).
  clientTaxName      String?
  clientTaxId        String?
  clientTaxDv        String?
  clientAddress      String?
  clientCity         String?
  clientBillingEmail String?
  legalRepName       String?

  // B) Ubicación y tipo de obra.
  siteAddress     String?
  siteCity        String?
  siteDepartment  String?
  projectType     String?
  siteAccessNotes String?

  // C) Responsables de la obra.
  technicalContact            String?
  technicalPhone              String?
  projectLeaderName           String?
  projectLeaderProfessionalId String?
  supervisorName              String?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([projectId])
  @@rls
}

/// Presupuesto de obra de un proyecto (FASE 2 — Tab 2). Un proyecto tiene
/// como máximo un presupuesto en esta fase (1:1 vía `projectId @unique`).
///
/// Montos y porcentajes en micro-unidades `BigInt` (6 decimales):
///   · dinero/cantidad: 1_000_000 = 1.000000
///   · porcentajes:     1_000_000 = 1.000000 = 100 % (100_000 = 10 %)
/// El servidor SIEMPRE recalcula los totales con `lib/apu-engine.ts`;
/// nunca se persisten totales enviados por el navegador.
model ProjectBudget {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Código de negocio: PRES-2026-001 (único dentro del tenant).
  code      String
  name      String

  /// Configuración AIU (fracción × 1e6). Por defecto 10 % / 5 % / 5 % / 19 %.
  aiuAdminPct     BigInt @default(100000)
  aiuImprevPct    BigInt @default(50000)
  aiuUtilidadPct  BigInt @default(50000)
  ivaUtilidadPct  BigInt @default(190000)

  /// Totales derivados (recalculados por el servidor en cada mutación).
  directCostTotal  BigInt @default(0)
  adminTotal       BigInt @default(0)
  imprevTotal      BigInt @default(0)
  utilidadTotal    BigInt @default(0)
  ivaUtilidadTotal BigInt @default(0)
  grandTotal       BigInt @default(0)

  /// Bloqueo básico: la capa de negocio rechaza mutaciones ordinarias.
  isLocked  Boolean  @default(false)
  /// Versión optimista: se incrementa en cada mutación del presupuesto para
  /// detectar ediciones concurrentes (STALE_REVISION).
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  chapters BudgetChapter[]
  baselines BudgetBaseline[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@rls
}

/// Capítulo (grupo de partidas) dentro de un presupuesto. `order` es el
/// orden de presentación; se asigna como `max + 1` al final del presupuesto.
model BudgetChapter {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetId  String
  budget    ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  order     Int
  name      String
  description String?
  createdAt DateTime      @default(now())
  updatedAt temporal.updatedAt()

  items BudgetItem[]

  @@unique([budgetId, order])
  @@index([tenantId])
  @@index([budgetId])
  @@rls
}

/// Partida / actividad presupuestaria dentro de un capítulo. Cantidad y
/// costos en micro-unidades `BigInt` (6 decimales).
model BudgetItem {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chapterId      String
  chapter        BudgetChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order          Int
  /// Código de actividad (puede repetirse entre capítulos).
  code           String
  description    String
  unit           String
  /// Cantidad escalada (1_000_000 = 1.000000).
  quantity       BigInt @default(1000000)
  /// Costo unitario directo (micro-pesos).
  unitCostDirect BigInt @default(0)
  /// Costo directo total de la partida = quantity × unitCostDirect.
  totalCostDirect BigInt @default(0)
  /// Origen: ID de actividad del catálogo APU desde la que se importó esta partida.
  sourceActivityId String?
  createdAt      DateTime      @default(now())
  updatedAt      temporal.updatedAt()

  resources BudgetItemResource[]
  progress  BudgetItemProgress[]
  lookaheadTasks LookaheadTask[]
  commitments    WeeklyCommitment[]
  fieldLogEntries FieldLogEntry[]

  @@unique([chapterId, order])
  @@index([tenantId])
  @@index([chapterId])
  @@rls
}

/// Recurso que compone la actividad (APU) de una partida. El editor
/// avanzado de composición queda para una fase posterior (N1 solo persiste
/// el modelo y lo muestra); `imageUrl` es opcional y sin integración externa.
model BudgetItemResource {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId        String
  item          BudgetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type          ResourceType
  name          String
  unit          String
  /// Rendimiento del recurso por unidad de actividad (1_000_000 = 1.0).
  performance   BigInt @default(1000000)
  unitPrice     BigInt @default(0)
  totalPrice    BigInt @default(0)
  imageUrl      String?
  /// Origen: ID de insumo del catálogo APU desde el que se importó este recurso.
  sourceItemId  String?
  /// Porcentaje de desperdicio de esta línea (micro, 1_000_000 = 100%). Default 0.
  wastePct      BigInt @default(0)
  /// Imagen del insumo en el sistema (copiada del catálogo al importar).
  imageId       String?
  /// Sección original de la línea en el APU del catálogo.
  section       String?
  /// Orden de la línea dentro del APU.
  order         Int    @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([itemId])
  @@rls
}

/// Acta de avance de una partida: cantidad ejecutada en el período que cierra
/// en `cutoffDate` (micro-unidades, se acumula). Es la fuente del valor ganado.
model BudgetItemProgress {
  id               String     @id @default(uuid())
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetItemId     String
  budgetItem       BudgetItem @relation(fields: [budgetItemId], references: [id], onDelete: Cascade)
  cutoffDate       DateTime
  executedQuantity BigInt
  note             String?
  authorName       String
  createdAt        DateTime   @default(now())

  @@index([tenantId])
  @@index([budgetItemId, cutoffDate])
  @@rls
}

/// Línea base aprobada del presupuesto (D1 — revisiones baseline). Congela la
/// revisión, los totales y los conteos del presupuesto en el instante de la
/// aprobación para comparar después contra el avance y el costo real (FASE 5).
/// Solo OWNER / SUPERADMIN pueden aprobar (D7). Un presupuesto puede acumular
/// varias líneas base; la de mayor `version` es la vigente.
model BudgetBaseline {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetId  String
  budget    ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  /// Revisión del presupuesto (`ProjectBudget.revision`) **en el momento de aprobar**.
  /// No cambia aunque el presupuesto se edite después; congela la revisión histórica.
  budgetRevision Int
  /// Número de secuencia de la línea base dentro del presupuesto (1, 2, 3…).
  /// Se auto-incrementa por presupuesto (`@@unique([budgetId, version])`).
  version        Int

  /// Snapshot de totales en micro-unidades al momento de aprobar.
  directCostTotal  BigInt
  adminTotal       BigInt
  imprevTotal      BigInt
  utilidadTotal    BigInt
  ivaUtilidadTotal BigInt
  grandTotal       BigInt

  /// Conteos del estado congelado.
  chapterCount Int
  itemCount    Int
  /// Snapshot informativo del árbol de capítulos ({ order, name, subtotal }).
  snapshot Json?

  note           String?
  approvedById   String
  approvedByName String

  createdAt DateTime @default(now())

  @@unique([budgetId, version])
  @@index([tenantId])
  @@index([budgetId])
  @@rls
}

/// Evento de bloqueo/desbloqueo del presupuesto (solo agregar).
/// Se crea en la misma transacción que el cambio de `isLocked`.
model BudgetLockEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetId  String
  budget    ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  action    String   // "LOCK" | "UNLOCK"
  reason    String?
  userId    String
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([budgetId])
  @@index([budgetId, createdAt])
  @@rls
}

/// Plan operativo Lean (Last Planner System) de un proyecto (FASE 3 — Tab 3).
/// Un proyecto tiene como máximo un plan en esta fase (1:1 vía `projectId
/// @unique`, lo que impide duplicados ante creación concurrente).
///
/// Semántica de la ventana Lookahead: `windowStartDate` ancla el lunes (día
/// calendario en America/Bogota) de la SEMANA RELATIVA 1 de la ventana de 6
/// semanas. La posición de una tarea dentro de la ventana se calcula como
/// `weekNumber = floor((startDate − windowStartDate) / 7 días) + 1`. Al
/// avanzar la ventana operativa se desplaza `windowStartDate` y se recalcula
/// `weekNumber` de cada tarea, de modo que la planificación no se queda
/// "congelada" en semanas relativas fijas.
model ProjectPlan {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String @default("Plan Operativo de Obra")
  /// Meta de cumplimiento (PPC) en porcentaje. Configurable, no universal.
  targetPpc Int    @default(85)
  /// Lunes (00:00 Bogotá) de la semana relativa 1 de la ventana Lookahead.
  windowStartDate DateTime

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  lookaheadTasks LookaheadTask[]
  commitments    WeeklyCommitment[]

  @@index([tenantId])
  @@index([tenantId, projectId])
  @@rls
}

/// Tarea de la ventana Lookahead (6 semanas) de un plan operativo. `weekNumber`
/// es la SEMANA RELATIVA dentro de la ventana (1..6 en la ventana vigente;
/// puede quedar <= 0 cuando la ventana avanza y la tarea pasa al histórico).
/// NO es una semana calendario (ver `WeeklyCommitment`).
model LookaheadTask {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String
  plan        ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Código de la tarea dentro del plan (p. ej. LKA-01). No único.
  code        String
  description String
  /// Semana relativa dentro de la ventana Lookahead.
  weekNumber  Int
  startDate   DateTime
  endDate     DateTime
  /// Responsable o cuadrilla.
  responsible String
  /// Restricción real identificada por el equipo (no decorativa).
  isRestricted Boolean @default(false)
  notes       String?
  /// Partida del presupuesto a la que se refiere (opcional).
  budgetItemId String?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, weekNumber])
  @@rls
}

/// Compromiso del Plan de Trabajo Semanal (WWP). `weekNumber` y `year` son la
/// SEMANA CALENDARIO ISO-8601 y su año ISO (en America/Bogota), NO la semana
/// relativa del Lookahead. El estado refleja el RESULTADO evaluado del
/// compromiso; `failureCause`/`failureNotes` solo existen mientras el estado
/// es FAILED (se limpian al cambiar de estado).
model WeeklyCommitment {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         ProjectPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Semana calendario ISO-8601 (1..53).
  weekNumber   Int
  /// Año ISO-8601 (puede diferir del año natural en los bordes de enero).
  year         Int
  description  String
  responsible  String
  status       CommitmentStatus  @default(PENDING)
  /// Causa de no cumplimiento (solo cuando `status = FAILED`).
  failureCause NonComplianceCause?
  failureNotes String?
  /// Partida del presupuesto a la que se refiere (opcional).
  budgetItemId String?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    temporal.updatedAt()

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, weekNumber, year])
  @@rls
}

/// Bitácora de campo de un proyecto (FASE 4 — Tab 4). Un proyecto tiene
/// como máximo una bitácora en esta fase (1:1 vía `projectId @unique`).
model FieldLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   @default("Diario Oficial de Obra")
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  entries FieldLogEntry[]

  @@index([tenantId])
  @@index([tenantId, projectId])
  @@rls
}

/// Anotación del Diario Oficial de Obra (FASE 4 — Tab 4).
model FieldLogEntry {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logId       String
  log         FieldLog         @relation(fields: [logId], references: [id], onDelete: Cascade)
  entryDate   DateTime
  type        FieldNoteType    @default(ADVANCE)
  title       String
  description String
  weather     WeatherCondition @default(SUNNY)
  laborCount  Int              @default(0)
  authorName  String
  authorRole  String
  photoUrls   String[]         @default([])
  /// Partida del presupuesto a la que se refiere (opcional).
  budgetItemId String?
  budgetItem   BudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
  @@index([logId])
  @@index([tenantId, entryDate])
  @@rls
}


/// Rol del equipo interno de NEXUS (Operations Center). Los permisos son
/// claves controladas por `lib/ops/permissions.ts`; `system` = rol base que
/// no se puede borrar (sí editar, salvo el de Propietario).
model StaffRole {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  permissions String[]
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  members StaffMember[]
  invites StaffInvite[]
  @@rls
}

/// Invitación al equipo de NEXUS: un enlace de un solo uso que ata una cuenta
/// de Clerk concreta a la ficha del integrante. Evita depender de que la
/// persona se registre con el mismo correo.
model StaffInvite {
  id          String    @id @default(uuid())
  token       String    @unique
  email       String
  roleId      String
  role        StaffRole @relation(fields: [roleId], references: [id])
  /// Quién generó la invitación.
  createdById String?
  /// Vence (por defecto 7 días).
  expiresAt   DateTime
  /// Cuándo se usó (la cuenta quedó vinculada).
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()

  @@index([email])
  @@index([roleId])
  @@rls
}

/// Integrante del equipo NEXUS. No pertenece a ningún negocio: su acceso al
/// panel sale de su rol. Se invita por correo; `clerkUserId` se completa
/// la primera vez que entra con ese correo.
model StaffMember {
  id          String    @id @default(uuid())
  clerkUserId String?   @unique
  email       String    @unique
  name        String?
  title       String?
  roleId      String
  role        StaffRole @relation(fields: [roleId], references: [id])
  active      Boolean   @default(true)
  invitedById String?
  joinedAt    DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   temporal.updatedAt()

  @@index([roleId])
  @@rls
}

/// Contactos de un negocio para el equipo NEXUS (no son clientes del
/// negocio): para qué sirve cada canal y cuándo contactarlo.
model TenantContact {
  id               String   @id @default(uuid())
  tenantId         String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  /// Dueño, administrativo, técnico, comercial…
  purpose          String
  phone            String?
  whatsapp         String?
  email            String?
  preferredChannel String?
  hours            String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()

  @@index([tenantId])
  @@rls
}


/// Catálogo comercial editable desde el Operations Center (Planes y módulos).
/// El onboarding y el servidor calculan precios con estas filas; los valores
/// iniciales salen de `defaultPricingConfig()` (lib/plans/pricing.ts).
model PlanSetting {
  key                String   @id
  name               String
  tagline            String
  features           String[]
  basePriceUsdCents  Int
  moduleDiscountPct  Int
  includesAllModules Boolean
  chargesModules     Boolean
  annualDiscountPct  Int
  recommended        Boolean  @default(false)
  active             Boolean  @default(true)
  order              Int
  /// Usuarios del negocio incluidos (null = sin límite).
  maxUsers           Int?
  updatedAt          temporal.updatedAt()
  @@rls
}

model ModuleSetting {
  module        String  @id
  label         String
  description   String
  priceUsdCents Int
  /// READY | BETA | PLANNED (controlado por el código).
  status        String
  included      Boolean
  order         Int
  updatedAt     temporal.updatedAt()
  @@rls
}

model VerticalSetting {
  vertical          String   @id
  label             String
  signupEnabled     Boolean
  priceFactorPct    Int
  modules           String[]
  recommended       String[]
  dashboardTemplate String?
  order             Int
  updatedAt         temporal.updatedAt()
  @@rls
}

model CustomerTierSetting {
  id            String @id
  label         String
  maxCustomers  Int?
  priceUsdCents Int
  order         Int
  updatedAt     temporal.updatedAt()
  @@rls
}


/// Prospecto comercial de NEXUS. Regla: ningún lead activo sin responsable
/// (StaffMember.id) ni próximo paso con fecha.
model Lead {
  id             String    @id @default(uuid())
  company        String
  contactName    String?
  phone          String?
  email          String?
  vertical       String?
  city           String?
  source         String
  stage          LeadStage @default(NEW)
  ownerId        String?
  nextStep       String?
  nextStepAt     DateTime?
  valueUsdCents  Int       @default(0)
  plan           String?
  notes          String?
  lostReason     String?
  /// Negocio en el que se convirtió (al ganarse).
  tenantId       String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stageChangedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      temporal.updatedAt()
  activities     LeadActivity[]

  @@index([stage])
  @@index([ownerId])

  @@index([tenantId])
  @@rls
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// note | call | whatsapp | email | meeting | stage
  kind      String
  body      String
  staffId   String?
  staffName String?
  createdAt DateTime @default(now())

  @@index([leadId])
  @@rls
}

/// Ticket de soporte de un negocio (SUP-2026-00124 = año + consecutivo).
model SupportTicket {
  id               String         @id @default(uuid())
  year             Int
  seq              Int
  tenantId         String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject          String
  description      String
  category         String
  priority         TicketPriority @default(NORMAL)
  status           TicketStatus   @default(NEW)
  channel          String
  assigneeId       String?
  requesterName    String?
  requesterContact String?
  solution         String?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        temporal.updatedAt()
  messages         TicketMessage[]

  @@unique([year, seq])
  @@index([status])
  @@index([tenantId])
  @@rls
}

model TicketMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Nota interna: solo la ve el equipo NEXUS.
  internal      Boolean       @default(false)
  body          String
  authorStaffId String?
  authorName    String
  createdAt     DateTime      @default(now())

  @@index([ticketId])
  @@rls
}


/// Suscripción vigente de un negocio. El precio se fija al crearla (no cambia
/// si luego se edita el catálogo).
model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan               String
  billingCycle       String
  /// Precio mensual equivalente (USD centavos).
  priceUsdCents      Int
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  notes              String?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          temporal.updatedAt()
  charges            Charge[]
  @@rls
}

/// Cobro de un período. Regla: no se confirma sin comprobante.
model Charge {
  id             String       @id @default(uuid())
  tenantId       String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  amountUsdCents Int
  status         ChargeStatus @default(PENDING)
  dueAt          DateTime
  method         String?
  reference      String?
  paidAt         DateTime?
  recordedById   String?
  confirmedById  String?
  confirmedAt    DateTime?
  /// Aviso de suspensión enviado al negocio (requisito para suspender).
  noticeSentAt   DateTime?
  refundedAt     DateTime?
  refundReason   String?
  voidReason     String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()
  evidence       ChargeEvidence[]

  @@unique([subscriptionId, periodStart])
  @@index([tenantId])
  @@index([status])
  @@rls
}

/// Comprobante de pago guardado en el sistema (no un enlace externo).
model ChargeEvidence {
  id           String   @id @default(uuid())
  chargeId     String
  charge       Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  byteSize     Int
  sha256       String
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([chargeId])
  @@rls
}

/// Política de cobro y suspensión (una fila, id "default").
model BillingPolicy {
  id           String @id
  reminderDays Int[]
  graceDays    Int
  noticeDays   Int
  updatedAt    temporal.updatedAt()
  @@rls
}

/// Beneficio promocional canjeable. Es el destino de la tarjeta NFC/QR
/// (`/c/{code}`): otorga un plan por N días sin costo (p. ej. 30 días de Elite).
model BenefitCode {
  id           String          @id @default(uuid())
  /// Código legible que viaja en la URL (único, en mayúsculas).
  code         String          @unique
  label        String
  /// Plan que se otorga al canjear.
  plan         TenantPlan      @default(ELITE)
  /// Regalo (promoción) o acceso pagado confirmado.
  kind         BenefitKind     @default(PROMO)
  /// Duración del beneficio en días (30 = un mes).
  durationDays Int             @default(30)
  /// Usos máximos; null = ilimitado.
  maxUses      Int?
  usedCount    Int             @default(0)
  active       Boolean         @default(true)
  /// Caducidad del código (opcional).
  expiresAt    DateTime?
  notes        String?
  /// Contrato a medida (todo opcional; vacío = el plan normal y gratis):
  /// precio mensual acordado en centavos de USD. Con precio, el canje deja la
  /// suscripción ACTIVA con ese precio (Facturación) en vez de prueba gratis.
  priceUsdCents Int?
  /// Módulos exactos que activa (si está vacío, los del plan).
  modules       String[]?
  /// Límites de ese cliente (null = los del plan).
  maxUsers      Int?
  maxCustomers  Int?
  /// StaffMember.id que lo creó.
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    temporal.updatedAt()
  redemptions  BenefitRedemption[]

  @@index([active])
  @@rls
}

/// Canje de un beneficio por un negocio. Un negocio no puede canjear el mismo
/// código dos veces (`@@unique([codeId, tenantId])`).
model BenefitRedemption {
  id           String      @id @default(uuid())
  codeId       String
  code         BenefitCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantName   String
  plan         String
  /// Regalo o acceso pagado (se copia del código al momento del canje).
  kind         BenefitKind @default(PROMO)
  durationDays Int
  /// Precio mensual acordado al canjear (copia del código; null = gratis).
  priceUsdCents Int?
  startsAt     DateTime
  endsAt       DateTime
  clerkUserId  String?
  email        String?
  createdAt    DateTime    @default(now())

  @@unique([codeId, tenantId])
  @@index([tenantId])
  @@index([codeId])
  @@rls
}


/// Conversación de la bandeja de NEXUS con un contacto (un hilo por canal y
/// contacto). Se vincula al negocio por sus contactos o usuarios.
model InboxConversation {
  id            String             @id @default(uuid())
  channel       InboxChannel
  /// WhatsApp: solo dígitos con indicativo. Correo: en minúsculas.
  contactHandle String
  contactName   String?
  tenantId      String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject       String?
  status        ConversationStatus @default(OPEN)
  assigneeId    String?
  ticketId      String?
  unread        Int                @default(0)
  lastMessageAt DateTime           @default(now())
  /// Último mensaje del contacto (ventana de 24 h de WhatsApp).
  lastInboundAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     temporal.updatedAt()
  messages      InboxMessage[]

  @@unique([channel, contactHandle])
  @@index([status])
  @@index([tenantId])
  @@rls
}

model InboxMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// IN (del contacto) | OUT (del equipo) | NOTE (nota interna)
  direction      String
  body           String
  /// Id del proveedor (evita duplicar reintentos del webhook).
  externalId     String?           @unique
  /// received | sent | manual | failed
  delivery       String
  error          String?
  authorStaffId  String?
  authorName     String?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@rls
}

/// Encuesta de satisfacción de un ticket resuelto (enlace público con token).
model SatisfactionSurvey {
  id         String    @id @default(uuid())
  ticketId   String    @unique
  tenantId   String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assigneeId String?
  token      String    @unique
  /// 1 a 5 (CSAT).
  score      Int?
  /// 0 a 10 (¿recomendarías NEXUS?).
  nps        Int?
  comment    String?
  sentAt     DateTime  @default(now())
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@rls
}


/// Archivo del negocio guardado en la base (comprobantes, fotos de clientes,
/// soportes de gastos, logos). `kind` + `ownerId` dicen a qué pertenece.
model Attachment {
  id           String   @id @default(uuid())
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         String
  ownerId      String
  fileName     String
  mimeType     String
  byteSize     Int
  sha256       String
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, kind, ownerId])
  @@rls
}

/// Caja menor: un fondo fijo con responsable.
model CashBox {
  id                String   @id @default(uuid())
  tenantId          String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  fundAmount        Decimal  @default(0)
  responsibleUserId String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         temporal.updatedAt()
  sessions          CashSession[]

  @@index([tenantId])
  @@rls
}

/// Turno de caja: apertura, movimientos y cierre con arqueo.
model CashSession {
  id             String   @id @default(uuid())
  tenantId       String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  boxId          String
  box            CashBox  @relation(fields: [boxId], references: [id], onDelete: Cascade)
  openedAt       DateTime @default(now())
  openedById     String
  openingAmount  Decimal
  closedAt       DateTime?
  closedById     String?
  expectedAmount Decimal?
  countedAmount  Decimal?
  difference     Decimal?
  closingNotes   String?
  movements      CashMovement[]

  @@index([tenantId, boxId])
  @@rls
}

model CashMovement {
  id          String           @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId   String
  session     CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        CashMovementKind
  amount      Decimal
  description String
  /// Quién recibe el vale.
  beneficiary String?
  paymentId   String?
  expenseId   String?
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([sessionId])

  @@index([tenantId])
  @@rls
}

/// Catálogo del negocio: productos, servicios, planes, entradas y tours.
model Product {
  id              String      @id @default(uuid())
  tenantId        String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind            ProductKind @default(PRODUCT)
  name            String
  description     String?
  sku             String?
  category        String?
  price           Decimal
  cost            Decimal?
  trackStock      Boolean     @default(false)
  stock           Int         @default(0)
  minStock        Int         @default(0)
  unit            String?
  /// Servicios y tours: duración de la cita / del recorrido.
  durationMinutes Int?
  /// Planes de membresía: días de vigencia.
  durationDays    Int?
  /// Cupo por cita, clase o salida.
  capacity        Int?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       temporal.updatedAt()
  movements       StockMovement[]
  /// Unidad de medida UN/CEFACT (la que usa la DIAN): EA unidad, KGM, LTR, MTR, HUR…
  unitCode        String      @default("EA")
  /// GRAVADO | EXCLUIDO | EXENTO
  taxCategory     String      @default("GRAVADO")
  taxRatePct      Decimal     @default(0)
  brand           String?
  imageUrl        String?
  /// Decide qué sale en el sitio y la tienda en línea.
  publishedOnline Boolean     @default(false)
  variants        ProductVariant[]
  barcodes        ProductBarcode[]
  priceItems      PriceListItem[]
  stockLevels     StockLevel[]
  purchaseLines   PurchaseOrderLine[]

  @@index([tenantId, kind])
  @@rls
}

/// Variante de un producto (talla, color…). El precio vacío hereda el del producto.
model ProductVariant {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  name       String
  /// Atributos libres: { "talla": "M", "color": "negro" }.
  attributes Json?
  price      Decimal?
  cost       Decimal?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()
  barcodes   ProductBarcode[]
  priceItems PriceListItem[]
  stockLevels StockLevel[]

  @@index([tenantId, productId])
  @@index([tenantId, sku], unique: true, where: "\"sku\" IS NOT NULL", name: "ProductVariant_tenantId_sku_key")
  @@rls
}

/// Código de barras de un producto o de una variante. Único por negocio.
model ProductBarcode {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  code       String
  /// EAN13 | EAN8 | UPCA | CODE128 | INTERNO
  symbology  String          @default("EAN13")
  createdAt  DateTime        @default(now())

  @@unique([tenantId, code])
  @@index([productId])
  @@rls
}

/// Lista de precios (público, mayorista, convenio…). Una por negocio es la predeterminada.
model PriceList {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  currency  String   @default("COP")
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  items     PriceListItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@rls
}

model PriceListItem {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceListId String
  priceList   PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price       Decimal
  updatedAt   temporal.updatedAt()

  /// Un precio por (lista, producto) y otro por (lista, producto, variante).
  @@index([priceListId, productId], unique: true, where: "\"variantId\" IS NULL", name: "PriceListItem_product_key")
  @@index([priceListId, productId, variantId], unique: true, where: "\"variantId\" IS NOT NULL", name: "PriceListItem_variant_key")
  @@index([productId])
  @@rls
}

model StockMovement {
  id          String   @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// IN (entrada) | OUT (salida) | SALE (venta) | ADJUST (ajuste de inventario)
  kind        String
  quantity    Int
  note        String?
  paymentId   String?
  createdById String?
  createdAt   DateTime @default(now())
  /// Bodega del movimiento y variante (null = producto sin variante).
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  variantId   String?
  /// Costo unitario al momento del movimiento (entrada: lo que costó; salida: costo promedio vigente).
  unitCost    Decimal?
  /// Saldo de la bodega justo después del movimiento (kardex).
  balanceAfter Int?
  /// Documento de origen: PURCHASE | SALE | TRANSFER | COUNT | ADJUSTMENT…
  documentType String?
  documentId   String?
  reason       String?

  @@index([productId])
  @@index([warehouseId])
  @@index([documentType, documentId])

  @@index([tenantId])
  @@rls
}

/// Recibo o cuenta de cobro numerada (la factura electrónica DIAN llega
/// después, con un proveedor).
model Invoice {
  id           String        @id @default(uuid())
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Documento comercial unificado (lib/business/commercial-document.ts):
  /// QUOTE | ORDER | BILL (cuenta de cobro) | RECEIPT | SALE (venta registrada
  /// al cobrar) | CREDIT_NOTE. Cada tipo lleva su consecutivo.
  kind         String
  number       Int
  customerId   String?
  customerName String
  customerDoc  String?
  issueDate    DateTime
  dueDate      DateTime?
  status       InvoiceStatus @default(ISSUED)
  notes        String?
  /// Base antes de descuentos, descuentos e impuestos (la suma de las líneas).
  subtotal      Decimal       @default(0)
  discountTotal Decimal       @default(0)
  taxTotal      Decimal       @default(0)
  total        Decimal
  voidReason   String?
  createdById  String?
  /// Obra a la que pertenece la cuenta de cobro (constructoras).
  projectId    String?
  /// Documento del que sale (cotización → pedido → cuenta; venta → nota crédito).
  sourceDocumentId String?
  /// Qué lo originó al cobrar: SALE (mostrador), TICKET_SALE, MEMBERSHIP… y su id.
  originType   String?
  originId     String?
  /// Cobro que lo generó (ventas registradas al cobrar).
  paymentId    String?
  createdAt    DateTime      @default(now())
  updatedAt    temporal.updatedAt()
  lines        InvoiceLine[]

  @@unique([tenantId, kind, number])
  @@index([tenantId])
  @@index([tenantId, issueDate])
  @@index([sourceDocumentId])
  @@rls
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Decimal
  unitPrice   Decimal
  /// Descuento e impuesto de la línea en % (0 = sin descuento / exenta).
  discountPct Decimal @default(0)
  taxRatePct  Decimal @default(0)
  total       Decimal

  @@index([invoiceId])
  @@rls
}


/// Invitación para unirse al equipo de un negocio (se acepta al iniciar
/// sesión con ese correo).
model TenantInvite {
  id          String    @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  name        String?
  role        Role
  invitedById String?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([email])
  @@rls
}

/// Notificaciones que la persona descartó (deslizando).
model DismissedNotification {
  id        String   @id @default(uuid())
  userId    String
  key       String
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@rls
}


/// Entrada al gimnasio (o al sitio) con su resultado: permitida o negada y por qué.
model Attendance {
  id           String   @id @default(uuid())
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Socio identificado. Nulo cuando lo escaneado no corresponde a nadie
  /// (código o tarjeta desconocida): el intento queda registrado igual.
  customerId   String?
  membershipId String?
  /// Lo que se escaneó, cuando no se pudo identificar al socio.
  scanned      String?
  /// NFC | QR | MANUAL
  method       String
  allowed      Boolean
  reason       String?
  createdById  String?
  at           DateTime @default(now())

  @@index([tenantId, at])
  @@index([customerId])
  @@rls
}

/// Venta de taquilla (museo): entradas por tipo para una fecha y franja.
model TicketSale {
  id          String   @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      Int
  visitDate   DateTime
  /// Franja horaria "10:00".
  slot        String
  visitors    Int
  /// [{ productId, name, qty, unitPrice }]
  lines       Json
  total       Decimal
  /// TAQUILLA | GRUPO | COLEGIO | GUIADA
  kind        String   @default("TAQUILLA")
  groupName   String?
  customerId  String?
  paymentId   String?
  /// PAID | RESERVED | VOID
  status      String   @default("PAID")
  /// Cita en la agenda (visitas guiadas y colegios).
  bookingId   String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, visitDate])
  @@rls
}

/// Salida programada de un tour o paquete (agencias de turismo).
model Departure {
  id           String   @id @default(uuid())
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  date         DateTime
  time         String?
  capacity     Int
  guide        String?
  meetingPoint String?
  /// SCHEDULED | DONE | CANCELLED
  status       String   @default("SCHEDULED")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  @@index([tenantId, date])
  @@rls
}

/// Reserva de un cliente en una salida: pasajeros, valor, abonos y voucher.
model TourBooking {
  id            String   @id @default(uuid())
  tenantId      String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departureId   String
  customerId    String
  seats         Int
  /// [{ name, document, nationality }]
  passengers    Json
  total         Decimal
  /// Código del voucher (ej. NX-7K2P9).
  code          String
  sellerUserId  String?
  commissionPct Int?
  /// RESERVED | CONFIRMED | CANCELLED
  status        String   @default("RESERVED")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([tenantId, code])
  @@index([departureId])
  @@rls
}

/// Solicitud de "Presence Thrive": el negocio pide su presencia digital
/// (web profesional, redes, ficha de Google). El equipo NEXUS la diseña, la
/// cobra una vez y la publica. `publishedUrl` alimenta la vista previa del
/// panel de presencia en el dashboard.
model PresenceRequest {
  id            String    @id @default(uuid())
  tenantId      String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// PENDING | DESIGN | REVIEW | PUBLISHED | CANCELLED
  status        String    @default("PENDING")
  businessName  String
  domain        String?
  slogan        String?
  /// Colores de marca separados por coma (#0B0B0C,#D4AF37).
  colors        String?
  notes         String?
  contactName   String
  contactPhone  String
  contactEmail  String?
  /// Precio único acordado (COP, sin decimales).
  priceCop      Int?
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?
  /// URL del sitio publicado; alimenta la vista previa (iframe) del panel.
  publishedUrl  String?
  staffNotes    String?
  /// Servicios solicitados: WEB | INSTAGRAM | GOOGLE. Null = solo WEB.
  services      String[]?
  requestedById String?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([status])
  @@rls
}

/// Foto del estado de presencia digital de un negocio en un momento dado.
/// `score` (0-100) lo calcula lib/presence; `breakdown` guarda el detalle por
/// criterio (auto verificado vs. declarado) y `website` el resultado del
/// sondeo al sitio publicado. El panel del Inicio lee el último escaneo.
model PresenceScan {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 0-100.
  score     Int
  /// INVISIBLE | VISIBLE | CONECTADO | DOMINANTE
  state     String
  /// AUTO (sondeo del servidor) | MANUAL (lo disparó el negocio).
  source    String   @default("MANUAL")
  /// Detalle por criterio: { key, label, points, earned, verified, hint }[].
  breakdown Json
  /// Sondeo del sitio: { reachable, https, statusCode, title, meta, viewport }.
  website   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@rls
}

/// Llave de API de un negocio (X.02, PR-02). Solo se guarda el hash; la llave
/// completa se muestra una vez al crearla. Su rol efectivo nunca supera el de
/// quien la creó (`createdByRole`) y sus alcances recortan lo que ve.
model ApiKey {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  /// Primeros caracteres visibles (nx_live_ab12…) para reconocerla en la lista.
  keyPrefix     String
  /// SHA-256 de la llave completa.
  keyHash       String    @unique
  /// live | test
  environment   String    @default("live")
  /// Alcances: `*`, `read`, `<recurso>.*` o un id de operación.
  scopes        String[]
  ipAllowlist   String[]
  createdById   String?
  createdByRole String?
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()
  requestLogs   ApiRequestLog[]
  idempotencyRecords IdempotencyRecord[]

  @@index([tenantId])
  @@rls
}

/// Registro de cada llamada a la API (sin cuerpos ni secretos).
model ApiRequestLog {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeyId       String?
  apiKey         ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  requestId      String
  method         String
  path           String
  operationId    String?
  status         Int
  durationMs     Int
  idempotencyKey String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([apiKeyId, createdAt])
  @@rls
}

/// Respuesta guardada para la misma `Idempotency-Key` (24 h).
model IdempotencyRecord {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeyId       String
  apiKey         ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([apiKeyId, key])
  @@index([expiresAt])
  @@rls
}

/// Hecho de negocio ya ocurrido (`sale.completed`…), escrito en la MISMA
/// transacción que el hecho. Un despachador lo reparte a los webhooks del negocio.
model OutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String
  version       Int       @default(1)
  resourceType  String?
  resourceId    String?
  payload       Json
  createdAt     DateTime  @default(now())
  /// Cuándo se repartió a las suscripciones (null = pendiente).
  processedAt   DateTime?
  deliveries    WebhookDelivery[]

  @@index([tenantId, createdAt])
  @@index([processedAt, createdAt])
  @@rls
}

/// URL HTTPS del cliente que recibe eventos firmados. El secreto se guarda cifrado.
model WebhookEndpoint {
  id                   String    @id @default(uuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url                  String
  description          String?
  secretEnc            String
  previousSecretEnc    String?
  previousSecretUntil  DateTime?
  /// Vacío = todos los eventos.
  eventTypes           String[]
  active               Boolean   @default(true)
  consecutiveFailures  Int       @default(0)
  disabledAt           DateTime?
  disabledReason       String?
  createdById          String?
  createdAt            DateTime  @default(now())
  updatedAt            temporal.updatedAt()
  deliveries           WebhookDelivery[]

  @@index([tenantId, active])
  @@rls
}

/// Entrega de un evento a un endpoint: una fila por par, con su contador de
/// intentos (reintentos exponenciales; FAILED = bandeja de fallidos, reenviable).
model WebhookDelivery {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointId      String
  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId         String
  event           OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Intentos ya hechos.
  attempt         Int       @default(0)
  /// PENDING | SUCCESS | FAILED
  status          String    @default("PENDING")
  responseStatus  Int?
  responseExcerpt String?
  durationMs      Int?
  nextAttemptAt   DateTime?
  createdAt       DateTime  @default(now())
  deliveredAt     DateTime?

  @@unique([endpointId, eventId])
  @@index([tenantId, status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@rls
}

/// Consumo medido por negocio, medidor y periodo (`YYYY-MM`). Base de los cupos
/// (`limitQuantity` null = el predeterminado del medidor) y del cobro por uso.
model UsageCounter {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// api.requests | events.delivered | ai.tokens | messages.sent | automations.runs
  meter         String
  period        String
  quantity      Int      @default(0)
  limitQuantity Int?
  updatedAt     temporal.updatedAt()

  @@unique([tenantId, meter, period])
  @@index([tenantId, period])
  @@rls
}

/// Conexión de un negocio con un proveedor externo (pasarela de pago,
/// facturación electrónica, mensajería…) detrás de un «puerto». Las credenciales
/// se guardan cifradas; nunca salen por la API ni la pantalla.
model ExternalConnection {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// PAYMENT | EINVOICE | MESSAGING | SHIPPING
  kind             String
  /// sandbox | wompi | nequi | whatsapp | <proveedor DIAN>…
  provider         String
  /// sandbox | production
  environment      String   @default("sandbox")
  /// DISCONNECTED | CONNECTED | ERROR
  status           String   @default("DISCONNECTED")
  credentialsEnc   String?
  /// Clave con la que se cifró (permite rotarla).
  credentialsKeyId String?
  config           Json?
  lastCheckedAt    DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()
  events           ProviderEvent[]

  @@unique([tenantId, kind, provider, environment])
  @@index([tenantId, kind])
  @@rls
}

/// Evento que un proveedor envía a NEXUS (webhook entrante). Solo se guarda con
/// firma válida y una sola vez por (negocio, proveedor, id externo).
model ProviderEvent {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId  String
  connection    ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider      String
  kind          String
  /// Tipo normalizado (`payment.succeeded`…).
  eventType     String
  externalId    String
  rawBody       String
  processedAt   DateTime?
  error         String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, createdAt])
  @@index([processedAt])
  @@rls
}

/// Tercero único: una persona o empresa del negocio, una sola vez, con los roles
/// que cumple (cliente, proveedor, empleado, contacto). Los documentos
/// comerciales, la cartera y la contabilidad cuelgan de aquí.
model Party {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// PERSON | COMPANY
  kind           String   @default("PERSON")
  /// CC | NIT | CE | PASAPORTE | TI | RC | NIT_EXTRANJERO (opcional: puede ser desconocido).
  documentType   String?
  /// Solo letras y números, sin puntos ni guiones ni dígito de verificación.
  documentNumber String?
  checkDigit     String?
  legalName      String
  tradeName      String?
  email          String?
  phone          String?
  addressLine    String?
  city           String?
  countryCode    String   @default("CO")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      temporal.updatedAt()
  roles          PartyRole[]
  customers      Customer[]
  purchaseOrders PurchaseOrder[]
  supplierInvoices SupplierInvoice[]

  @@index([tenantId, legalName])
  /// Un documento identifica a UN tercero por negocio.
  @@index([tenantId, documentNumber], unique: true, where: "\"documentNumber\" IS NOT NULL", name: "Party_tenantId_documentNumber_key")
  @@rls
}

model PartyRole {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  /// CUSTOMER | SUPPLIER | EMPLOYEE | CONTACT
  role      String
  createdAt DateTime @default(now())

  @@unique([partyId, role])
  @@index([tenantId, role])
  @@rls
}

/// Bodega o punto de almacenamiento. Una es la predeterminada («Principal»).
model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  address   String?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  levels    StockLevel[]
  movements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@rls
}

/// Existencias de un producto (o variante) en una bodega, con su costo promedio.
/// `Product.stock` es la suma de las bodegas (se mantiene para las pantallas actuales).
model StockLevel {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  /// Costo promedio ponderado por unidad.
  avgCost     Decimal  @default(0)
  /// variantId o "" (sin variante): permite una restricción única normal, sin índices parciales.
  variantKey  String   @default("")
  updatedAt   temporal.updatedAt()

  @@unique([warehouseId, productId, variantKey])
  @@index([tenantId, productId])
  @@rls
}

/// Orden de compra a un proveedor (tercero con rol SUPPLIER). Al recibir la mercancía
/// entra al inventario con su costo por el servicio de inventario.
model PurchaseOrder {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Consecutivo por negocio (OC-0001).
  number          Int
  supplierPartyId String
  supplier        Party    @relation(fields: [supplierPartyId], references: [id], onDelete: Restrict)
  /// Bodega a la que entra la mercancía.
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELED
  status          String   @default("DRAFT")
  expectedDate    String?
  subtotal        Decimal  @default(0)
  taxTotal        Decimal  @default(0)
  total           Decimal  @default(0)
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()
  lines           PurchaseOrderLine[]
  invoices        SupplierInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@rls
}

model PurchaseOrderLine {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  quantity         Int
  receivedQuantity Int      @default(0)
  /// Costo por unidad SIN impuesto: es el que entra al costo promedio.
  unitCost         Decimal
  taxRatePct       Decimal  @default(0)

  @@index([orderId])
  @@rls
}

/// Factura que el proveedor entrega por una compra. Es el insumo de las cuentas por pagar (PR-14).
model SupplierInvoice {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierPartyId String
  supplier        Party    @relation(fields: [supplierPartyId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  /// Número que trae la factura del proveedor.
  number          String
  issueDate       String
  dueDate         String?
  subtotal        Decimal
  taxTotal        Decimal  @default(0)
  total           Decimal
  /// REGISTERED | PAID | VOID
  status          String   @default("REGISTERED")
  /// CUFE de la factura electrónica, si la trae.
  cufe            String?
  createdAt       DateTime @default(now())

  @@unique([tenantId, supplierPartyId, number])
  @@index([tenantId, dueDate])
  @@rls
}
