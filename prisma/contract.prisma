// use prisma-8

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

/// Perfil del negocio en el onboarding auto-servicio: persona natural vs empresa.
enum TenantType {
  /// Emprendedor / persona natural (perfil liviano: sin NIT obligatorio).
  INDIVIDUAL
  /// Empresa / negocio establecido (perfil completo: NIT, tamaño, dirección).
  COMPANY
}

enum Vertical {
  gym
  tourism_agency
  hospitality
  construction
  carpentry
  restaurant
  retail
  beauty
  healthcare
  mechanic
  education
  real_estate
  hardware_store
  nautical_transport
  tour_guides
  events
}

enum ModuleName {
  crm
  dashboard
  bookings
  payments
  billing
  inventory
  finance
  whatsapp
  memberships
  orders
  quotes
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
}

enum PaymentProvider {
  WOMPI
  NEQUI
  CASH
  TRANSFER
}

enum MembershipType {
  mensual
  trimestral
  anual
}

enum MembershipStatus {
  active
  expiring
  expired
}

/// Categoría de un insumo del banco APU (Análisis de Precios Unitarios).
enum ApuItemCategory {
  MATERIAL
  MANO_DE_OBRA
  EQUIPO
  TRANSPORTE
}

/// Estado de un presupuesto/cotización de obra.
enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

/// Ciclo de vida de un proyecto de obra (vertical construcción).
enum ProjectStatus {
  DRAFT
  BIDDING
  APPROVED
  IN_EXECUTION
  COMPLETED
  CANCELLED
}

/// Categoría de un recurso que compone la actividad (APU) de una partida
/// presupuestaria (FASE 2 — Tab 2). Distinto de `ApuItemCategory` (banco de
/// insumos reutilizable): aquí es la clasificación dentro de un presupuesto.
enum ResourceType {
  MATERIAL
  LABOR
  EQUIPMENT
  TRANSPORT
}

/// Resultado evaluado de un compromiso semanal (Last Planner System). No
/// representa el avance de una tarea: es el resultado del compromiso de la
/// semana — pendiente de evaluar, cumplido o no cumplido (FASE 3 — Tab 3).
enum CommitmentStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Causa de No Cumplimiento (CNC) de un compromiso fallido. Catálogo base
/// del sistema CNC (Last Planner System).
enum NonComplianceCause {
  WEATHER
  MATERIALS
  LABOR
  EQUIPMENT
  DESIGN_CHANGE
  PREVIOUS_WORK
  OTHER
}

/// Tipo de anotación en la bitácora de campo (FASE 4 — Tab 4).
enum FieldNoteType {
  ADVANCE
  OBSERVATION
  AUTHORIZATION
  INCIDENT
}

/// Condición meteorológica registrada en una anotación de campo (FASE 4 — Tab 4).
enum WeatherCondition {
  SUNNY
  CLOUDY
  RAIN_LIGHT
  RAIN_HEAVY
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  vertical     Vertical
  active       Boolean  @default(true)

  /// Wizard de onboarding: false = el tenant es nuevo y debe configurarse.
  onboardingCompleted Boolean @default(false)
  /// Perfil adaptativo (onboarding auto-servicio). Las reglas de validación
  /// viven en lib/onboarding/validation.ts; estos campos son la persistencia.
  tenantType TenantType @default(COMPANY)
  /// Razón social (solo COMPANY; el nombre comercial vive en `name`).
  legalName String?
  /// NIT/RUT (obligatorio en COMPANY, opcional en INDIVIDUAL).
  taxId String?
  /// Tamaño del equipo: "SOLO" | "2-5" | "6-20" | "20+" (guardado como texto
  /// validado por la app; el enum rígido dificultaría agregar rangos).
  teamSize String?
  /// Dirección física; "REMOTE" si el negocio no tiene local.
  address String?
  /// Identidad y ubicación (Paso 1 del onboarding).
  city              String?
  whatsappNumber    String?
  /// Ecosistema digital (Paso 3 del onboarding).
  websiteUrl        String?
  instagramHandle   String?
  googleBusinessUrl String?
  /// Métodos de pago aceptados (Paso 4 del onboarding; catálogo PaymentProvider).
  /// Nullable en DB: un tenant nuevo aún no los configuró; el código normaliza a [].
  paymentMethods    PaymentProvider[]?

  /// Suspensión administrativa (Panel CEO): motivo obligatorio + timestamp.
  /// Se conserva aunque el tenant se reactive (historial de por qué se suspendió).
  suspendedReason String?
  suspendedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  users         User[]
  customers     Customer[]
  payments      Payment[]
  expenses      Expense[]
  memberships   Membership[]
  modules       TenantModule[]
  customerNotes CustomerNote[]
  apuItems      ApuItem[]
  apuActivities ApuActivity[]
  quotes        Quote[]
  projects      Project[]
  projectBudgets ProjectBudget[]
  budgetChapters BudgetChapter[]
  budgetItems   BudgetItem[]
  budgetItemResources BudgetItemResource[]
  budgetBaselines   BudgetBaseline[]
  projectPlans      ProjectPlan[]
  lookaheadTasks    LookaheadTask[]
  weeklyCommitments WeeklyCommitment[]
  fieldLogs         FieldLog[]

  @@index([slug])
}

model TenantModule {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleName ModuleName
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  temporal.updatedAt()

  @@unique([tenantId, moduleName])
  @@index([tenantId])
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String
  email       String
  name        String?
  role        Role     @default(STAFF)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  customerNotes CustomerNote[]

  @@unique([clerkUserId, tenantId])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  payments Payment[]
  memberships Membership[]
  notes CustomerNote[]
  quotes Quote[]
  projects Project[]

  @@index([tenantId])
}

model Payment {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  membershipId  String?
  membership    Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amount        Decimal
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(CASH)
  providerRefId String?         @unique
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([providerRefId])
  @@index([membershipId])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
}

model Membership {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       MembershipType
  startDate  DateTime
  endDate    DateTime
  status     MembershipStatus @default(active)
  price      Decimal
  /// Historial de cobros registrados (JSON serializable: [{ date, amount, provider, kind }]).
  payments   Json?
  charges    Payment[]
  createdAt  DateTime         @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([tenantId, endDate])
  @@index([customerId])
}

/// Observación interna sobre un cliente (Ficha 360°). Sin módulo propio:
/// pertenece al núcleo del CRM.
model CustomerNote {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  /// User.id del autor (se conserva el contenido si el usuario se elimina).
  createdBy  String?
  author     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([customerId])
}

/// Insumo/recurso básico del banco APU (material, mano de obra, equipo o
/// transporte). El `code` es opcional pero único DENTRO del tenant cuando existe.
model ApuItem {
  id        String          @id @default(uuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String?
  name      String
  unit      String
  category  ApuItemCategory
  unitPrice Decimal
  updatedAt temporal.updatedAt()

  compositions ApuActivityComposition[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Actividad de obra reutilizable (ej. M2 de muro en ladrillo). Se compone
/// de insumos con rendimiento (`consumption`) y desperdicio (`wastePercent`).
model ApuActivity {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String?
  name        String
  unit        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  compositions ApuActivityComposition[]
  quoteItems  QuoteItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Composición de una actividad APU: insumo + rendimiento + desperdicio.
/// Se elimina en cascada con la actividad.
model ApuActivityComposition {
  id           String      @id @default(uuid())
  activityId   String
  activity     ApuActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  itemId       String
  item         ApuItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Cantidad del insumo por unidad de actividad (rendimiento).
  consumption  Decimal
  /// Porcentaje de desperdicio (0–50).
  wastePercent Decimal

  @@unique([activityId, itemId])
  @@index([activityId])
  @@index([itemId])
}

model Booking {
  id          String        @id @default(uuid())
  tenantId    String
  customerId  String
  serviceName String
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(PENDING)
  totalAmount BigInt        @default(0)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  @@index([tenantId])
  @@index([customerId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

/// Encabezado de un presupuesto/cotización de obra.
model Quote {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  title         String
  /// Código de negocio: PRES-2026-001 (único dentro del tenant).
  code          String
  status        QuoteStatus @default(DRAFT)
  adminPercent  Decimal     @default(15)
  imprevPercent Decimal     @default(5)
  utilPercent   Decimal     @default(10)
  taxPercent    Decimal     @default(19)
  directCost    Decimal
  totalAmount   Decimal
  createdAt     DateTime    @default(now())
  updatedAt     temporal.updatedAt()

  items QuoteItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([customerId])
}

/// Registro de auditoría de acciones privilegiadas del SuperAdmin
/// (suspensión, activación, módulos, exportación, impersonación). No se
/// relaciona por FK con Tenant a propósito: la auditoría debe sobrevivir al
/// borrado del negocio. NUNCA guarda secretos ni tokens.
model AuditLog {
  id         String   @id @default(uuid())
  /// Clerk user id del SuperAdmin actor (no expone datos sensibles).
  actorId    String
  actorEmail String?
  /// Acción auditada (string controlado por el código, no un enum: las
  /// migraciones de enum en Prisma 8 son frágiles y aquí no aportan valor).
  action     String
  /// Negocio objetivo (puede ser null en acciones globales como exportar).
  targetTenantId   String?
  targetTenantName String?
  /// Metadatos serializables (motivo, módulos, filas exportadas…). Sin secretos.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetTenantId])
  @@index([actorId])
}

/// Actividad dentro de un presupuesto. Congela nombre, unidad, cantidad y
/// costos al momento de cotizar; opcionalmente guarda el snapshot del APU.
model QuoteItem {
  id          String       @id @default(uuid())
  quoteId     String
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  activityId  String?
  activity    ApuActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  name        String
  unit        String
  quantity    Decimal
  unitCost    Decimal
  totalCost   Decimal
  /// Fotografía inmutable del APU utilizado (catálogo + composición + precios).
  apuSnapshot Json?

  @@index([quoteId])
  @@index([activityId])
}

/// Contenedor de un proyecto de obra (FASE 1 del vertical construcción).
/// Cada proyecto es dueño de su ficha (`ProjectHeader`, 1:1) y, en fases
/// posteriores, de presupuestos, planificación y bitácora.
///
/// Aislamiento multi-tenant: toda consulta filtra por `tenantId` y la capa
/// de negocio valida que el `Customer` pertenezca al mismo tenant antes de
/// vincularlo (el índice compuesto impide cruces accidentales de lectura).
model Project {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Código de negocio: PROY-2026-001 (único dentro del tenant).
  code       String
  name       String
  description String?
  status     ProjectStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  temporal.updatedAt()

  header   ProjectHeader?
  /// Presupuesto de obra del proyecto (1:1 en esta fase, Tab 2).
  budget   ProjectBudget?
  /// Plan operativo Lean (Last Planner System) del proyecto (1:1, Tab 3).
  plan     ProjectPlan?
  /// Bitácora de campo del proyecto (1:1, Tab 4).
  fieldLog FieldLog?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
}

/// 1:1 con Proyecto. Snapshot inicial tomado del Customer del CRM al crear
/// el proyecto (no es una segunda fuente maestra de cliente: el maestro
/// sigue siendo `Customer`; aquí se congela lo que aplica a ESTA obra).
model ProjectHeader {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // A) Datos tributarios / contractuales del cliente (snapshot del CRM).
  clientTaxName      String?
  clientTaxId        String?
  clientTaxDv        String?
  clientAddress      String?
  clientCity         String?
  clientBillingEmail String?
  legalRepName       String?

  // B) Ubicación y tipo de obra.
  siteAddress     String?
  siteCity        String?
  siteDepartment  String?
  projectType     String?
  siteAccessNotes String?

  // C) Responsables de la obra.
  technicalContact            String?
  technicalPhone              String?
  projectLeaderName           String?
  projectLeaderProfessionalId String?
  supervisorName              String?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  @@index([projectId])
}

/// Presupuesto de obra de un proyecto (FASE 2 — Tab 2). Un proyecto tiene
/// como máximo un presupuesto en esta fase (1:1 vía `projectId @unique`).
///
/// Montos y porcentajes en micro-unidades `BigInt` (6 decimales):
///   · dinero/cantidad: 1_000_000 = 1.000000
///   · porcentajes:     1_000_000 = 1.000000 = 100 % (100_000 = 10 %)
/// El servidor SIEMPRE recalcula los totales con `lib/apu-engine.ts`;
/// nunca se persisten totales enviados por el navegador.
model ProjectBudget {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Código de negocio: PRES-2026-001 (único dentro del tenant).
  code      String
  name      String

  /// Configuración AIU (fracción × 1e6). Por defecto 10 % / 5 % / 5 % / 19 %.
  aiuAdminPct     BigInt @default(100000)
  aiuImprevPct    BigInt @default(50000)
  aiuUtilidadPct  BigInt @default(50000)
  ivaUtilidadPct  BigInt @default(190000)

  /// Totales derivados (recalculados por el servidor en cada mutación).
  directCostTotal  BigInt @default(0)
  adminTotal       BigInt @default(0)
  imprevTotal      BigInt @default(0)
  utilidadTotal    BigInt @default(0)
  ivaUtilidadTotal BigInt @default(0)
  grandTotal       BigInt @default(0)

  /// Bloqueo básico: la capa de negocio rechaza mutaciones ordinarias.
  isLocked  Boolean  @default(false)
  /// Versión optimista: se incrementa en cada mutación del presupuesto para
  /// detectar ediciones concurrentes (STALE_REVISION).
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  chapters BudgetChapter[]
  baselines BudgetBaseline[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// Capítulo (grupo de partidas) dentro de un presupuesto. `order` es el
/// orden de presentación; se asigna como `max + 1` al final del presupuesto.
model BudgetChapter {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetId  String
  budget    ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  order     Int
  name      String
  description String?
  createdAt DateTime      @default(now())
  updatedAt temporal.updatedAt()

  items BudgetItem[]

  @@unique([budgetId, order])
  @@index([tenantId])
  @@index([budgetId])
}

/// Partida / actividad presupuestaria dentro de un capítulo. Cantidad y
/// costos en micro-unidades `BigInt` (6 decimales).
model BudgetItem {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chapterId   String
  chapter     BudgetChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order       Int
  /// Código de actividad (puede repetirse entre capítulos).
  code        String
  description String
  unit        String
  /// Cantidad escalada (1_000_000 = 1.000000).
  quantity        BigInt @default(1000000)
  /// Costo unitario directo (micro-pesos).
  unitCostDirect  BigInt @default(0)
  /// Costo directo total de la partida = quantity × unitCostDirect.
  totalCostDirect BigInt @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   temporal.updatedAt()

  resources BudgetItemResource[]

  @@unique([chapterId, order])
  @@index([tenantId])
  @@index([chapterId])
}

/// Recurso que compone la actividad (APU) de una partida. El editor
/// avanzado de composición queda para una fase posterior (N1 solo persiste
/// el modelo y lo muestra); `imageUrl` es opcional y sin integración externa.
model BudgetItemResource {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId    String
  item      BudgetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      ResourceType
  name      String
  unit      String
  /// Rendimiento del recurso por unidad de actividad (1_000_000 = 1.0).
  performance BigInt @default(1000000)
  unitPrice   BigInt @default(0)
  totalPrice  BigInt @default(0)
  imageUrl    String?
  createdAt DateTime   @default(now())
  updatedAt temporal.updatedAt()

  @@index([tenantId])
  @@index([itemId])
}

/// Línea base aprobada del presupuesto (D1 — revisiones baseline). Congela la
/// revisión, los totales y los conteos del presupuesto en el instante de la
/// aprobación para comparar después contra el avance y el costo real (FASE 5).
/// Solo OWNER / SUPERADMIN pueden aprobar (D7). Un presupuesto puede acumular
/// varias líneas base; la de mayor `version` es la vigente.
model BudgetBaseline {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgetId  String
  budget    ProjectBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  /// Revisión del presupuesto capturada al aprobar (`ProjectBudget.revision`).
  budgetRevision Int
  /// Número de línea base dentro del presupuesto (1, 2, …).
  version        Int

  /// Snapshot de totales en micro-unidades al momento de aprobar.
  directCostTotal  BigInt
  adminTotal       BigInt
  imprevTotal      BigInt
  utilidadTotal    BigInt
  ivaUtilidadTotal BigInt
  grandTotal       BigInt

  /// Conteos del estado congelado.
  chapterCount Int
  itemCount    Int
  /// Snapshot informativo del árbol de capítulos ({ order, name, subtotal }).
  snapshot Json?

  note           String?
  approvedById   String
  approvedByName String

  createdAt DateTime @default(now())

  @@unique([budgetId, version])
  @@index([tenantId])
  @@index([budgetId])
}

/// Plan operativo Lean (Last Planner System) de un proyecto (FASE 3 — Tab 3).
/// Un proyecto tiene como máximo un plan en esta fase (1:1 vía `projectId
/// @unique`, lo que impide duplicados ante creación concurrente).
///
/// Semántica de la ventana Lookahead: `windowStartDate` ancla el lunes (día
/// calendario en America/Bogota) de la SEMANA RELATIVA 1 de la ventana de 6
/// semanas. La posición de una tarea dentro de la ventana se calcula como
/// `weekNumber = floor((startDate − windowStartDate) / 7 días) + 1`. Al
/// avanzar la ventana operativa se desplaza `windowStartDate` y se recalcula
/// `weekNumber` de cada tarea, de modo que la planificación no se queda
/// "congelada" en semanas relativas fijas.
model ProjectPlan {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String @default("Plan Operativo de Obra")
  /// Meta de cumplimiento (PPC) en porcentaje. Configurable, no universal.
  targetPpc Int    @default(85)
  /// Lunes (00:00 Bogotá) de la semana relativa 1 de la ventana Lookahead.
  windowStartDate DateTime

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  lookaheadTasks LookaheadTask[]
  commitments    WeeklyCommitment[]

  @@index([tenantId])
  @@index([tenantId, projectId])
}

/// Tarea de la ventana Lookahead (6 semanas) de un plan operativo. `weekNumber`
/// es la SEMANA RELATIVA dentro de la ventana (1..6 en la ventana vigente;
/// puede quedar <= 0 cuando la ventana avanza y la tarea pasa al histórico).
/// NO es una semana calendario (ver `WeeklyCommitment`).
model LookaheadTask {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId      String
  plan        ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Código de la tarea dentro del plan (p. ej. LKA-01). No único.
  code        String
  description String
  /// Semana relativa dentro de la ventana Lookahead.
  weekNumber  Int
  startDate   DateTime
  endDate     DateTime
  /// Responsable o cuadrilla.
  responsible String
  /// Restricción real identificada por el equipo (no decorativa).
  isRestricted Boolean @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, weekNumber])
}

/// Compromiso del Plan de Trabajo Semanal (WWP). `weekNumber` y `year` son la
/// SEMANA CALENDARIO ISO-8601 y su año ISO (en America/Bogota), NO la semana
/// relativa del Lookahead. El estado refleja el RESULTADO evaluado del
/// compromiso; `failureCause`/`failureNotes` solo existen mientras el estado
/// es FAILED (se limpian al cambiar de estado).
model WeeklyCommitment {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId       String
  plan         ProjectPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Semana calendario ISO-8601 (1..53).
  weekNumber   Int
  /// Año ISO-8601 (puede diferir del año natural en los bordes de enero).
  year         Int
  description  String
  responsible  String
  status       CommitmentStatus  @default(PENDING)
  /// Causa de no cumplimiento (solo cuando `status = FAILED`).
  failureCause NonComplianceCause?
  failureNotes String?
  createdAt    DateTime          @default(now())
  updatedAt    temporal.updatedAt()

  @@index([tenantId])
  @@index([planId])
  @@index([tenantId, weekNumber, year])
}

/// Bitácora de campo de un proyecto (FASE 4 — Tab 4). Un proyecto tiene
/// como máximo una bitácora en esta fase (1:1 vía `projectId @unique`).
model FieldLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String   @default("Diario Oficial de Obra")
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  entries FieldLogEntry[]

  @@index([tenantId])
  @@index([tenantId, projectId])
}

/// Anotación del Diario Oficial de Obra (FASE 4 — Tab 4).
model FieldLogEntry {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logId       String
  log         FieldLog         @relation(fields: [logId], references: [id], onDelete: Cascade)
  entryDate   DateTime
  type        FieldNoteType    @default(ADVANCE)
  title       String
  description String
  weather     WeatherCondition @default(SUNNY)
  laborCount  Int              @default(0)
  authorName  String
  authorRole  String
  photoUrls   String[]         @default([])
  createdAt   DateTime         @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
  @@index([logId])
  @@index([tenantId, entryDate])
}
