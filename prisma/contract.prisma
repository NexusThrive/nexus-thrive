// use prisma-8

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

enum Vertical {
  gym
  barber
  restaurant
  services
}

enum ModuleName {
  caja_menor
  membresias
  reservas
  pedidos
  presupuestos
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
}

enum PaymentProvider {
  WOMPI
  NEQUI
  CASH
  TRANSFER
}

enum MembershipType {
  mensual
  trimestral
  anual
}

enum MembershipStatus {
  active
  expiring
  expired
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  vertical     Vertical @default(services)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  users       User[]
  customers   Customer[]
  payments    Payment[]
  expenses    Expense[]
  memberships Membership[]
  modules     TenantModule[]

  @@index([slug])
}

model TenantModule {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleName ModuleName
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  temporal.updatedAt()

  @@unique([tenantId, moduleName])
  @@index([tenantId])
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String
  email       String
  name        String?
  role        Role     @default(STAFF)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@unique([clerkUserId, tenantId])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  payments Payment[]
  memberships Membership[]

  @@index([tenantId])
}

model Payment {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  membershipId  String?
  membership    Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amount        Decimal
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(CASH)
  providerRefId String?         @unique
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([providerRefId])
  @@index([membershipId])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
}

model Membership {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       MembershipType
  startDate  DateTime
  endDate    DateTime
  status     MembershipStatus @default(active)
  price      Decimal
  /// Historial de cobros registrados (JSON serializable: [{ date, amount, provider, kind }]).
  payments   Json?
  charges    Payment[]
  createdAt  DateTime         @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([tenantId, endDate])
  @@index([customerId])
}
