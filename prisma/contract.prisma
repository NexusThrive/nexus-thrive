// use prisma-8

enum Role {
  SUPERADMIN
  OWNER
  STAFF
}

enum Vertical {
  gym
  tourism_agency
  hospitality
  construction
  carpentry
  restaurant
  retail
  beauty
  healthcare
  mechanic
  education
  real_estate
  hardware_store
  nautical_transport
  tour_guides
  events
}

enum ModuleName {
  crm
  dashboard
  bookings
  payments
  billing
  inventory
  finance
  whatsapp
  memberships
  orders
  quotes
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
}

enum PaymentProvider {
  WOMPI
  NEQUI
  CASH
  TRANSFER
}

enum MembershipType {
  mensual
  trimestral
  anual
}

enum MembershipStatus {
  active
  expiring
  expired
}

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  customDomain String?  @unique
  vertical     Vertical
  active       Boolean  @default(true)

  /// Wizard de onboarding: false = el tenant es nuevo y debe configurarse.
  onboardingCompleted Boolean @default(false)
  /// Identidad y ubicación (Paso 1 del onboarding).
  city              String?
  whatsappNumber    String?
  /// Ecosistema digital (Paso 3 del onboarding).
  websiteUrl        String?
  instagramHandle   String?
  googleBusinessUrl String?
  /// Métodos de pago aceptados (Paso 4 del onboarding; catálogo PaymentProvider).
  /// Nullable en DB: un tenant nuevo aún no los configuró; el código normaliza a [].
  paymentMethods    PaymentProvider[]?

  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  users       User[]
  customers   Customer[]
  payments    Payment[]
  expenses    Expense[]
  memberships Membership[]
  modules     TenantModule[]

  @@index([slug])
}

model TenantModule {
  id         String       @id @default(uuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleName ModuleName
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  temporal.updatedAt()

  @@unique([tenantId, moduleName])
  @@index([tenantId])
}

model User {
  id          String   @id @default(uuid())
  clerkUserId String
  email       String
  name        String?
  role        Role     @default(STAFF)
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@unique([clerkUserId, tenantId])
  @@index([tenantId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  payments Payment[]
  memberships Membership[]

  @@index([tenantId])
}

model Payment {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  membershipId  String?
  membership    Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amount        Decimal
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(CASH)
  providerRefId String?         @unique
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([providerRefId])
  @@index([membershipId])
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
}

model Membership {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       MembershipType
  startDate  DateTime
  endDate    DateTime
  status     MembershipStatus @default(active)
  price      Decimal
  /// Historial de cobros registrados (JSON serializable: [{ date, amount, provider, kind }]).
  payments   Json?
  charges    Payment[]
  createdAt  DateTime         @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([tenantId, endDate])
  @@index([customerId])
}
