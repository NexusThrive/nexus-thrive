// use prisma-8

/// Pedido de la tienda en línea (mini-sitio): el cliente deja sus datos y el pedido espera el pago por el enlace de cobro
/// (o la confirmación manual de una transferencia). Al pagarse, descuenta existencias y deja su documento de venta.
///
/// Campos:
/// - `number`: Consecutivo por negocio (T-0001).
/// - `status`: PENDING_PAYMENT | PAID | CANCELED | ABANDONED
/// - `fulfillment`: Cumplimiento, separado del pago: RECEIVED | CONFIRMED | IN_PRODUCTION | READY | SHIPPED | DELIVERED | CANCELED. Los estados de pago (`status`) no cambian.
/// - `quoteId`: Cotización comercial aprobada de la que nació el pedido (no pasa por el cobro en línea ni se abandona).
/// - `intentId`: Cobro en línea del pedido (su enlace y su estado oficial).
/// - `documentId`: Documento de venta que deja al pagarse.
/// - `review`: Aviso para revisar a mano (p. ej. se pagó sin existencias suficientes).
/// - `origin`: De dónde llegó el cliente: { source, medium, campaign } (UTM).
model StoreOrder {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number             Int
  status             String    @default("PENDING_PAYMENT")
  customerId         String?
  quoteId            String?
  fulfillment        String    @default("RECEIVED")
  customerName       String
  phone              String
  email              String?
  address            String?
  city               String?
  notes              String?
  total              Decimal
  intentId           String?
  documentId         String?
  review             String?
  origin             Json?
  paidAt             DateTime?
  abandonedNotifiedAt DateTime?
  createdAt          DateTime  @default(now())
  lines              StoreOrderLine[]
  statusChanges      OrderStatusChange[]
  productionOrders   ProductionOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@rls
}

/// Línea de un pedido de la tienda en línea: producto, cantidad y precio.
model StoreOrderLine {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  quantity  Int
  unitPrice Decimal
  taxRatePct Decimal   @default(0)

  @@index([orderId])
  @@rls
}

/// Historial del cumplimiento de un pedido (HU-pedidos-01): cada cambio de estado con quién lo hizo y cuándo.
///
/// Campos:
/// - `fromStatus`, `toStatus`: Estado de cumplimiento antes y después.
/// - `byId`: Integrante que lo cambió; vacío = el sistema (p. ej. se canceló el pedido).
model OrderStatusChange {
  id         String     @id @default(uuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId    String
  order      StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  byId       String?
  note       String?
  createdAt  DateTime   @default(now())

  @@index([tenantId, orderId, createdAt])
  @@rls
}

/// Orden de producción (HU-produccion-01): lo que se fabrica de un pedido, una por línea, con su etapa y responsable. Nace cuando el pedido
/// pasa a «en producción»; cuando todas sus líneas están terminadas, el pedido pasa a «listo».
///
/// Campos:
/// - `stage`: QUEUED (en cola) | IN_PROGRESS (en curso) | DONE (terminada). Etapas mínimas a propósito; no se configuran todavía.
/// - `assigneeId`: Integrante responsable (`User.id`); vacío = sin asignar.
/// - `orderLineId`: Línea del pedido; una sola orden por línea.
model ProductionOrder {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId     String
  order       StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLineId String
  productName String
  quantity    Int
  stage       String     @default("QUEUED")
  assigneeId  String?
  note        String?
  startedAt   DateTime?
  doneAt      DateTime?
  createdAt   DateTime   @default(now())

  @@unique([tenantId, orderLineId])
  @@index([tenantId, stage, createdAt])
  @@index([tenantId, orderId])
  @@rls
}
