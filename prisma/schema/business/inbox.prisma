// use prisma-8

/// Bandeja de NEXUS (canales propios con los negocios).
enum InboxChannel {
  WHATSAPP
  EMAIL
}

/// Estado de una conversación de la bandeja de entrada.
enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

/// Conversación de la bandeja de NEXUS con un contacto (un hilo por canal y
/// contacto). Se vincula al negocio por sus contactos o usuarios.
///
/// Campos:
/// - `contactHandle`: WhatsApp: solo dígitos con indicativo. Correo: en minúsculas.
/// - `lastInboundAt`: Último mensaje del contacto (ventana de 24 h de WhatsApp).
model InboxConversation {
  id            String             @id @default(uuid())
  channel       InboxChannel
  contactHandle String
  contactName   String?
  tenantId      String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject       String?
  status        ConversationStatus @default(OPEN)
  assigneeId    String?
  ticketId      String?
  unread        Int                @default(0)
  lastMessageAt DateTime           @default(now())
  lastInboundAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     temporal.updatedAt()
  messages      InboxMessage[]

  @@unique([channel, contactHandle])
  @@index([status])
  @@index([tenantId])
  @@rls
}

/// Mensaje individual de una conversación de la bandeja de entrada, entrante o saliente.
///
/// Campos:
/// - `direction`: IN (del contacto) | OUT (del equipo) | NOTE (nota interna)
/// - `externalId`: Id del proveedor (evita duplicar reintentos del webhook).
/// - `delivery`: received | sent | manual | failed
model InboxMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      String
  body           String
  externalId     String?           @unique
  delivery       String
  error          String?
  authorStaffId  String?
  authorName     String?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@rls
}

/// Encuesta de satisfacción de un ticket resuelto (enlace público con token).
///
/// Campos:
/// - `score`: 1 a 5 (CSAT).
/// - `nps`: 0 a 10 (¿recomendarías NEXUS?).
model SatisfactionSurvey {
  id         String    @id @default(uuid())
  ticketId   String    @unique
  tenantId   String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assigneeId String?
  token      String    @unique
  score      Int?
  nps        Int?
  comment    String?
  sentAt     DateTime  @default(now())
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@rls
}
