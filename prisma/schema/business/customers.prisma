// use prisma-8

/// Cliente o socio de un negocio: contacto, código de acceso y tarjeta NFC. Se enlaza al tercero
/// único (Party) y es la base de pagos, membresías, cotizaciones y obras.
///
/// Campos:
/// - `profile`: Campos propios del rubro (gym: peso, talla, objetivo…; turismo: pasaporte…).
/// - `photoId`: Foto (Attachment.id, kind CUSTOMER_PHOTO).
/// - `accessCode`: Código de acceso (QR) y tarjeta NFC vinculada.
/// - `stage`: Etapa del contacto: PROSPECT | CUSTOMER | RECURRING (HU-contacto-unico-01). Los clientes que ya existían son CUSTOMER.
/// - `source`: De dónde llegó: MANUAL | WEB | STORE | REGISTRATION | IMPORT | WHATSAPP.
/// - `ownerId`: Integrante del equipo responsable (TenantMember.id).
/// - `phoneNorm`: Teléfono canónico (57 + 10 dígitos) para encontrar a la misma persona venga de donde venga.
/// - `consentAt`: Cuándo aceptó que lo contacten (tratamiento de datos); vacío = sin registro.
/// - `partyId`: Tercero único al que pertenece este cliente (la misma persona o empresa, con sus
///   roles).
/// - `@@index([tenantId,`: Un código o una tarjeta identifica a UN socio del negocio (DATA-04).
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  documentId String?
  birthDate  DateTime?
  tags       String[]?
  profile    Json?
  photoId    String?
  city       String?
  accessCode String?
  nfcUid     String?
  stage      String   @default("CUSTOMER")
  source     String?
  ownerId    String?
  phoneNorm  String?
  consentAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  payments Payment[]
  memberships Membership[]
  notes CustomerNote[]
  quotes Quote[]
  projects Project[]
  partyId  String?
  party    Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, phoneNorm])
  @@index([partyId])
  @@index([tenantId, accessCode], unique: true, where: "\"accessCode\" IS NOT NULL", name: "Customer_tenantId_accessCode_key")
  @@index([tenantId, nfcUid], unique: true, where: "\"nfcUid\" IS NOT NULL", name: "Customer_tenantId_nfcUid_key")
  @@rls
}

/// Observación interna sobre un cliente (Ficha 360°). Sin módulo propio:
/// pertenece al núcleo del CRM.
///
/// Campos:
/// - `createdBy`: User.id del autor (se conserva el contenido si el usuario se elimina).
model CustomerNote {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  createdBy  String?
  author     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([customerId])
  @@rls
}

/// Oportunidad (HU-leads-01): seguir a cada interesado hasta que compra o se pierde. Siempre ligada a UN contacto (`Customer`):
/// ganar una oportunidad no duplica a la persona. No es el CRM comercial de Nexus (`platform/crm`): es el del negocio.
///
/// Campos:
/// - `stage`: NEW | CONTACTED | QUOTED | NEGOTIATING (mientras está abierta).
/// - `status`: OPEN | WON | LOST. Al ganar o perder se guarda `closedAt`; perder pide `lostReason`.
/// - `leadId`: `ContactLead` de donde nació (los contactos del formulario que ya existían se migran con él).
/// - `orderId`: Pedido de la tienda con el que se ganó, si lo hubo.
/// - `nextAction`, `nextActionAt`: El siguiente paso y cuándo; la base de las tareas del seguimiento.
model Opportunity {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String
  interest      String
  estimatedValue Decimal?
  stage         String    @default("NEW")
  status        String    @default("OPEN")
  nextAction    String?
  nextActionAt  DateTime?
  ownerId       String?
  source        String?
  leadId        String?
  orderId       String?
  lostReason    String?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([tenantId, leadId])
  @@index([tenantId, status, stage])
  @@index([tenantId, customerId])
  @@rls
}

/// Tarea (HU-actividades-01): un paso concreto con fecha y responsable, ligado a un contacto o a una oportunidad. Es el ÚNICO
/// modelo de tareas de Business: los proyectos y entregables (etapa 4) lo reutilizan en vez de crear otro.
///
/// Campos:
/// - `assigneeId`: Integrante del equipo responsable (`User.id` del negocio); vacío = sin asignar.
/// - `dueDay`: Día de vencimiento «AAAA-MM-DD» en hora de Bogotá; vacío = sin fecha.
/// - `status`: OPEN | DONE. Al completarla se guarda `doneAt` y quién (`doneById`).
/// - `customerId`, `opportunityId`: A quién o a qué oportunidad se refiere (opcionales).
model Task {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  notes         String?
  dueDay        String?
  assigneeId    String?
  customerId    String?
  opportunityId String?
  status        String    @default("OPEN")
  doneAt        DateTime?
  doneById      String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([tenantId, status, dueDay])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, customerId])
  @@rls
}

/// Formulario de captura de interesados (HU-lead-capture-01): una clave PÚBLICA por formulario que una web externa (WordPress,
/// Next.js, Shopify) usa para enviar interesados a Nexus. La clave puede verse en el navegador; no da acceso a nada más que a
/// crear interesados desde los dominios permitidos. NO es una llave de API.
///
/// Campos:
/// - `publicKey`: Clave pública del formulario (`lf_…`), única en toda la plataforma.
/// - `allowedOrigins`: Orígenes web permitidos («https://mitienda.com»). Un envío desde otro origen se rechaza.
/// - `campaign`: Campaña por omisión de lo que llegue por este formulario.
model LeadForm {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  publicKey      String   @unique
  allowedOrigins String[]
  campaign       String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@rls
}
