// use prisma-8

/// Solicitud de "Presence Thrive": el negocio pide su presencia digital
/// (web profesional, redes, ficha de Google). El equipo NEXUS la diseña, la
/// cobra una vez y la publica. `publishedUrl` alimenta la vista previa del
/// panel de presencia en el dashboard.
model PresenceRequest {
  id            String    @id @default(uuid())
  tenantId      String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// PENDING | DESIGN | REVIEW | PUBLISHED | CANCELLED
  status        String    @default("PENDING")
  businessName  String
  domain        String?
  slogan        String?
  /// Colores de marca separados por coma (#0B0B0C,#D4AF37).
  colors        String?
  notes         String?
  contactName   String
  contactPhone  String
  contactEmail  String?
  /// Precio único acordado (COP, sin decimales).
  priceCop      Int?
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?
  /// URL del sitio publicado; alimenta la vista previa (iframe) del panel.
  publishedUrl  String?
  staffNotes    String?
  /// Servicios solicitados: WEB | INSTAGRAM | GOOGLE. Null = solo WEB.
  services      String[]?
  requestedById String?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([status])
  @@rls
}

/// Foto del estado de presencia digital de un negocio en un momento dado.
/// `score` (0-100) lo calcula lib/presence; `breakdown` guarda el detalle por
/// criterio (auto verificado vs. declarado) y `website` el resultado del
/// sondeo al sitio publicado. El panel del Inicio lee el último escaneo.
model PresenceScan {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 0-100.
  score     Int
  /// INVISIBLE | VISIBLE | CONECTADO | DOMINANTE
  state     String
  /// AUTO (sondeo del servidor) | MANUAL (lo disparó el negocio).
  source    String   @default("MANUAL")
  /// Detalle por criterio: { key, label, points, earned, verified, hint }[].
  breakdown Json
  /// Sondeo del sitio: { reachable, https, statusCode, title, meta, viewport }.
  website   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@rls
}

/// Foto diaria de la Presencia del negocio (una por día): puntaje de la fase A, sus pilares y cuántos se miden.
/// Sirve para la tendencia (¿sube o baja?) sin recalcular el pasado.
model PresenceSnapshot {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// AAAA-MM-DD (hora de Colombia).
  day       String
  score     Int
  /// Cobertura: % de los pilares verificables que ya se miden.
  coverage  Int
  /// A | B_READY
  phase     String
  /// [{ key, score|null, verified }]
  pillars   Json
  updatedAt temporal.updatedAt()

  @@unique([tenantId, day])
  @@rls
}

/// Mini-sitio público del negocio (`/s/<siteSlug>`): plantilla, textos, color y qué se muestra. Un negocio, un sitio.
model SiteConfig {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(false)
  /// Dirección pública del sitio, única en toda la plataforma (editable).
  siteSlug     String   @unique
  /// clasica | moderna | oscura | minimal
  template     String   @default("clasica")
  /// Título y descripción para buscadores (SEO).
  title        String?
  description  String?
  heroTitle    String?
  heroSubtitle String?
  about        String?
  accent       String   @default("#D4AF37")
  showCatalog  Boolean  @default(true)
  showMap      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  @@rls
}

/// Ficha de Google Business (Maps) del negocio, leída por la API de Google Places con la llave del negocio: lo que
/// Google muestra de él (nombre, dirección, teléfono, sitio, calificación y reseñas) para compararlo con lo que dice NEXUS.
model GoogleListing {
  id          String    @id @default(uuid())
  tenantId    String    @unique
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// ID de lugar de Google (ChIJ…).
  placeId     String
  /// PENDING | OK | ERROR
  status      String    @default("PENDING")
  name        String?
  address     String?
  phone       String?
  website     String?
  rating      Decimal?
  ratingCount Int?
  syncedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@rls
}

/// Enlace corto con UTM para una campaña (`/l/<código>`): redirige al sitio o la tienda del negocio con su origen marcado y cuenta los clics.
model TrackedLink {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Código corto único en toda la plataforma.
  code        String   @unique
  name        String
  /// Ruta dentro del sitio del negocio: "" (inicio) o "/p/<id>".
  path        String   @default("")
  utmSource   String
  utmMedium   String
  utmCampaign String
  /// Lo invertido en la campaña (para comparar contra lo que trajo).
  spend       Decimal  @default(0)
  clicks      Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@rls
}

/// Contacto que llega por el formulario del sitio, con su origen.
model ContactLead {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  message   String?
  /// { source, medium, campaign } o vacío (directo).
  origin    Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@rls
}

/// Reseña de un cliente: interna (enlace de reseña del negocio) o de Google. Las de 1–2 estrellas disparan una alerta.
model Review {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// INTERNAL | GOOGLE
  source       String    @default("INTERNAL")
  rating       Int
  comment      String?
  customerName String?
  contact      String?
  /// NEW | ALERTED | HANDLED
  status       String    @default("NEW")
  handledAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@rls
}
