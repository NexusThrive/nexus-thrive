// use prisma-8

/// Salida programada de un tour o paquete (agencias de turismo).
///
/// Campos:
/// - `status`: SCHEDULED | DONE | CANCELLED
model Departure {
  id           String   @id @default(uuid())
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  date         DateTime
  time         String?
  capacity     Int
  guide        String?
  meetingPoint String?
  status       String   @default("SCHEDULED")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  @@index([tenantId, date])
  @@rls
}

/// Reserva de un cliente en una salida: pasajeros, valor, abonos y voucher.
///
/// Campos:
/// - `passengers`: [{ name, document, nationality }]
/// - `code`: Código del voucher (ej. NX-7K2P9).
/// - `status`: RESERVED | CONFIRMED | CANCELLED
model TourBooking {
  id            String   @id @default(uuid())
  tenantId      String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departureId   String
  customerId    String
  seats         Int
  passengers    Json
  total         Decimal
  code          String
  sellerUserId  String?
  commissionPct Int?
  status        String   @default("RESERVED")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([tenantId, code])
  @@index([departureId])
  @@rls
}
