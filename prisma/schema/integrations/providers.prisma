// use prisma-8

/// Conexión de un negocio con un proveedor externo (pasarela de pago,
/// facturación electrónica, mensajería…) detrás de un «puerto». Las credenciales
/// se guardan cifradas; nunca salen por la API ni la pantalla.
///
/// Campos:
/// - `kind`: PAYMENT | EINVOICE | MESSAGING | SHIPPING
/// - `provider`: sandbox | wompi | nequi | whatsapp | <proveedor DIAN>…
/// - `environment`: sandbox | production
/// - `status`: DISCONNECTED | CONNECTED | ERROR
/// - `credentialsKeyId`: Clave con la que se cifró (permite rotarla).
model ExternalConnection {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind             String
  provider         String
  environment      String   @default("sandbox")
  status           String   @default("DISCONNECTED")
  credentialsEnc   String?
  credentialsKeyId String?
  config           Json?
  lastCheckedAt    DateTime?
  lastError        String?
  createdAt        DateTime @default(now())
  updatedAt        temporal.updatedAt()
  events           ProviderEvent[]

  @@unique([tenantId, kind, provider, environment])
  @@index([tenantId, kind])
  @@rls
}

/// Evento que un proveedor envía a NEXUS (webhook entrante). Solo se guarda con
/// firma válida y una sola vez por (negocio, proveedor, id externo).
///
/// Campos:
/// - `eventType`: Tipo normalizado (`payment.succeeded`…).
model ProviderEvent {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId  String
  connection    ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider      String
  kind          String
  eventType     String
  externalId    String
  rawBody       String
  processedAt   DateTime?
  error         String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, createdAt])
  @@index([processedAt])
  @@rls
}
