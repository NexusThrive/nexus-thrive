// use prisma-8

/// Solicitud de "Presence Thrive": el negocio pide su presencia digital
/// (web profesional, redes, ficha de Google). El equipo NEXUS la diseña, la
/// cobra una vez y la publica. `publishedUrl` alimenta la vista previa del
/// panel de presencia en el dashboard.
///
/// Campos:
/// - `status`: PENDING | DESIGN | REVIEW | PUBLISHED | CANCELLED
/// - `colors`: Colores de marca separados por coma (#0B0B0C,#D4AF37).
/// - `priceCop`: Precio único acordado (COP, sin decimales).
/// - `publishedUrl`: URL del sitio publicado; alimenta la vista previa (iframe) del panel.
/// - `services`: Servicios solicitados: WEB | INSTAGRAM | GOOGLE. Null = solo WEB.
model PresenceRequest {
  id            String    @id @default(uuid())
  tenantId      String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status        String    @default("PENDING")
  businessName  String
  domain        String?
  slogan        String?
  colors        String?
  notes         String?
  contactName   String
  contactPhone  String
  contactEmail  String?
  priceCop      Int?
  paidAt        DateTime?
  paymentMethod String?
  paymentRef    String?
  publishedUrl  String?
  staffNotes    String?
  services      String[]?
  requestedById String?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([status])
  @@rls
}

/// Foto del estado de presencia digital de un negocio en un momento dado.
/// `score` (0-100) lo calcula lib/presence; `breakdown` guarda el detalle por
/// criterio (auto verificado vs. declarado) y `website` el resultado del
/// sondeo al sitio publicado. El panel del Inicio lee el último escaneo.
///
/// Campos:
/// - `score`: 0-100.
/// - `state`: INVISIBLE | VISIBLE | CONECTADO | DOMINANTE
/// - `source`: AUTO (sondeo del servidor) | MANUAL (lo disparó el negocio).
/// - `breakdown`: Detalle por criterio: { key, label, points, earned, verified, hint }[].
/// - `website`: Sondeo del sitio: { reachable, https, statusCode, title, meta, viewport }.
model PresenceScan {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  score     Int
  state     String
  source    String   @default("MANUAL")
  breakdown Json
  website   Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@rls
}

/// Foto diaria de la Presencia del negocio (una por día): puntaje de la fase A, sus pilares y cuántos se miden.
/// Sirve para la tendencia (¿sube o baja?) sin recalcular el pasado.
///
/// Campos:
/// - `day`: AAAA-MM-DD (hora de Colombia).
/// - `coverage`: Cobertura: % de los pilares verificables que ya se miden.
/// - `phase`: A | B_READY
/// - `pillars`: [{ key, score|null, verified }]
model PresenceSnapshot {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  day       String
  score     Int
  coverage  Int
  phase     String
  pillars   Json
  updatedAt temporal.updatedAt()

  @@unique([tenantId, day])
  @@rls
}
