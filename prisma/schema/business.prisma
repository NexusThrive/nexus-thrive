// use prisma-8

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  active    Boolean  @default(true)
  documentId String?
  birthDate  DateTime?
  tags       String[]?
  /// Campos propios del rubro (gym: peso, talla, objetivo…; turismo: pasaporte…).
  profile    Json?
  /// Foto (Attachment.id, kind CUSTOMER_PHOTO).
  photoId    String?
  city       String?
  /// Código de acceso (QR) y tarjeta NFC vinculada.
  accessCode String?
  nfcUid     String?
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  payments Payment[]
  memberships Membership[]
  notes CustomerNote[]
  quotes Quote[]
  projects Project[]
  /// Tercero único al que pertenece este cliente (la misma persona o empresa, con sus roles).
  partyId  String?
  party    Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([partyId])
  /// Un código o una tarjeta identifica a UN socio del negocio (DATA-04).
  @@index([tenantId, accessCode], unique: true, where: "\"accessCode\" IS NOT NULL", name: "Customer_tenantId_accessCode_key")
  @@index([tenantId, nfcUid], unique: true, where: "\"nfcUid\" IS NOT NULL", name: "Customer_tenantId_nfcUid_key")
  @@rls
}

/// Observación interna sobre un cliente (Ficha 360°). Sin módulo propio:
/// pertenece al núcleo del CRM.
model CustomerNote {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  content    String
  /// User.id del autor (se conserva el contenido si el usuario se elimina).
  createdBy  String?
  author     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  @@index([tenantId])
  @@index([customerId])
  @@rls
}

model Booking {
  id          String        @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  serviceName String
  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(PENDING)
  totalAmount BigInt        @default(0)
  notes       String?
  /// Servicio, clase o tour del catálogo (Product).
  productId      String?
  /// Persona del equipo que atiende (User.id).
  staffUserId    String?
  partySize      Int       @default(1)
  /// APPOINTMENT | CLASS | DELIVERY | VISIT | DEPARTURE
  kind           String    @default("APPOINTMENT")
  reminderSentAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now())

  @@index([tenantId])
  @@index([customerId])
  @@rls
}

/// Beneficio promocional canjeable. Es el destino de la tarjeta NFC/QR
/// (`/c/{code}`): otorga un plan por N días sin costo (p. ej. 30 días de Elite).
model BenefitCode {
  id           String          @id @default(uuid())
  /// Código legible que viaja en la URL (único, en mayúsculas).
  code         String          @unique
  label        String
  /// Plan que se otorga al canjear.
  plan         TenantPlan      @default(ELITE)
  /// Regalo (promoción) o acceso pagado confirmado.
  kind         BenefitKind     @default(PROMO)
  /// Duración del beneficio en días (30 = un mes).
  durationDays Int             @default(30)
  /// Usos máximos; null = ilimitado.
  maxUses      Int?
  usedCount    Int             @default(0)
  active       Boolean         @default(true)
  /// Caducidad del código (opcional).
  expiresAt    DateTime?
  notes        String?
  /// Contrato a medida (todo opcional; vacío = el plan normal y gratis):
  /// precio mensual acordado en centavos de USD. Con precio, el canje deja la
  /// suscripción ACTIVA con ese precio (Facturación) en vez de prueba gratis.
  priceUsdCents Int?
  /// Módulos exactos que activa (si está vacío, los del plan).
  modules       String[]?
  /// Límites de ese cliente (null = los del plan).
  maxUsers      Int?
  maxCustomers  Int?
  /// StaffMember.id que lo creó.
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    temporal.updatedAt()
  redemptions  BenefitRedemption[]

  @@index([active])
  @@rls
}

/// Canje de un beneficio por un negocio. Un negocio no puede canjear el mismo
/// código dos veces (`@@unique([codeId, tenantId])`).
model BenefitRedemption {
  id           String      @id @default(uuid())
  codeId       String
  code         BenefitCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantName   String
  plan         String
  /// Regalo o acceso pagado (se copia del código al momento del canje).
  kind         BenefitKind @default(PROMO)
  durationDays Int
  /// Precio mensual acordado al canjear (copia del código; null = gratis).
  priceUsdCents Int?
  startsAt     DateTime
  endsAt       DateTime
  clerkUserId  String?
  email        String?
  createdAt    DateTime    @default(now())

  @@unique([codeId, tenantId])
  @@index([tenantId])
  @@index([codeId])
  @@rls
}

/// Conversación de la bandeja de NEXUS con un contacto (un hilo por canal y
/// contacto). Se vincula al negocio por sus contactos o usuarios.
model InboxConversation {
  id            String             @id @default(uuid())
  channel       InboxChannel
  /// WhatsApp: solo dígitos con indicativo. Correo: en minúsculas.
  contactHandle String
  contactName   String?
  tenantId      String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject       String?
  status        ConversationStatus @default(OPEN)
  assigneeId    String?
  ticketId      String?
  unread        Int                @default(0)
  lastMessageAt DateTime           @default(now())
  /// Último mensaje del contacto (ventana de 24 h de WhatsApp).
  lastInboundAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     temporal.updatedAt()
  messages      InboxMessage[]

  @@unique([channel, contactHandle])
  @@index([status])
  @@index([tenantId])
  @@rls
}

model InboxMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// IN (del contacto) | OUT (del equipo) | NOTE (nota interna)
  direction      String
  body           String
  /// Id del proveedor (evita duplicar reintentos del webhook).
  externalId     String?           @unique
  /// received | sent | manual | failed
  delivery       String
  error          String?
  authorStaffId  String?
  authorName     String?
  createdAt      DateTime          @default(now())

  @@index([conversationId])
  @@rls
}

/// Encuesta de satisfacción de un ticket resuelto (enlace público con token).
model SatisfactionSurvey {
  id         String    @id @default(uuid())
  ticketId   String    @unique
  tenantId   String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assigneeId String?
  token      String    @unique
  /// 1 a 5 (CSAT).
  score      Int?
  /// 0 a 10 (¿recomendarías NEXUS?).
  nps        Int?
  comment    String?
  sentAt     DateTime  @default(now())
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@rls
}

/// Catálogo del negocio: productos, servicios, planes, entradas y tours.
model Product {
  id              String      @id @default(uuid())
  tenantId        String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind            ProductKind @default(PRODUCT)
  name            String
  description     String?
  sku             String?
  category        String?
  price           Decimal
  cost            Decimal?
  trackStock      Boolean     @default(false)
  stock           Int         @default(0)
  minStock        Int         @default(0)
  unit            String?
  /// Servicios y tours: duración de la cita / del recorrido.
  durationMinutes Int?
  /// Planes de membresía: días de vigencia.
  durationDays    Int?
  /// Cupo por cita, clase o salida.
  capacity        Int?
  active          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       temporal.updatedAt()
  movements       StockMovement[]
  /// Unidad de medida UN/CEFACT (la que usa la DIAN): EA unidad, KGM, LTR, MTR, HUR…
  unitCode        String      @default("EA")
  /// GRAVADO | EXCLUIDO | EXENTO
  taxCategory     String      @default("GRAVADO")
  taxRatePct      Decimal     @default(0)
  brand           String?
  imageUrl        String?
  /// Decide qué sale en el sitio y la tienda en línea.
  publishedOnline Boolean     @default(false)
  variants        ProductVariant[]
  barcodes        ProductBarcode[]
  priceItems      PriceListItem[]
  stockLevels     StockLevel[]
  purchaseLines   PurchaseOrderLine[]
  transferLines   StockTransferLine[]
  countLines      StockCountLine[]
  /// Techo de existencias (para sugerir cuánto reponer).
  maxStock        Int?
  /// Cuando las existencias bajan a este número conviene pedir más.
  reorderPoint    Int?

  @@index([tenantId, kind])
  @@rls
}

/// Variante de un producto (talla, color…). El precio vacío hereda el del producto.
model ProductVariant {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String?
  name       String
  /// Atributos libres: { "talla": "M", "color": "negro" }.
  attributes Json?
  price      Decimal?
  cost       Decimal?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()
  barcodes   ProductBarcode[]
  priceItems PriceListItem[]
  stockLevels StockLevel[]

  @@index([tenantId, productId])
  @@index([tenantId, sku], unique: true, where: "\"sku\" IS NOT NULL", name: "ProductVariant_tenantId_sku_key")
  @@rls
}

/// Código de barras de un producto o de una variante. Único por negocio.
model ProductBarcode {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  code       String
  /// EAN13 | EAN8 | UPCA | CODE128 | INTERNO
  symbology  String          @default("EAN13")
  createdAt  DateTime        @default(now())

  @@unique([tenantId, code])
  @@index([productId])
  @@rls
}

/// Lista de precios (público, mayorista, convenio…). Una por negocio es la predeterminada.
model PriceList {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  currency  String   @default("COP")
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  items     PriceListItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@rls
}

model PriceListItem {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceListId String
  priceList   PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price       Decimal
  updatedAt   temporal.updatedAt()

  /// Un precio por (lista, producto) y otro por (lista, producto, variante).
  @@index([priceListId, productId], unique: true, where: "\"variantId\" IS NULL", name: "PriceListItem_product_key")
  @@index([priceListId, productId, variantId], unique: true, where: "\"variantId\" IS NOT NULL", name: "PriceListItem_variant_key")
  @@index([productId])
  @@rls
}

model StockMovement {
  id          String   @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// IN (entrada) | OUT (salida) | SALE (venta) | ADJUST (ajuste de inventario)
  kind        String
  quantity    Int
  note        String?
  paymentId   String?
  createdById String?
  createdAt   DateTime @default(now())
  /// Bodega del movimiento y variante (null = producto sin variante).
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  variantId   String?
  /// Costo unitario al momento del movimiento (entrada: lo que costó; salida: costo promedio vigente).
  unitCost    Decimal?
  /// Saldo de la bodega justo después del movimiento (kardex).
  balanceAfter Int?
  /// Documento de origen: PURCHASE | SALE | TRANSFER | COUNT | ADJUSTMENT…
  documentType String?
  documentId   String?
  reason       String?

  @@index([productId])
  @@index([warehouseId])
  @@index([documentType, documentId])

  @@index([tenantId])
  @@rls
}

/// Recibo o cuenta de cobro numerada (la factura electrónica DIAN llega
/// después, con un proveedor).
model Invoice {
  id           String        @id @default(uuid())
  tenantId     String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Documento comercial unificado (lib/business/commercial-document.ts):
  /// QUOTE | ORDER | BILL (cuenta de cobro) | RECEIPT | SALE (venta registrada
  /// al cobrar) | CREDIT_NOTE. Cada tipo lleva su consecutivo.
  kind         String
  number       Int
  customerId   String?
  customerName String
  customerDoc  String?
  issueDate    DateTime
  dueDate      DateTime?
  status       InvoiceStatus @default(ISSUED)
  notes        String?
  /// Base antes de descuentos, descuentos e impuestos (la suma de las líneas).
  subtotal      Decimal       @default(0)
  discountTotal Decimal       @default(0)
  taxTotal      Decimal       @default(0)
  total        Decimal
  voidReason   String?
  createdById  String?
  /// Obra a la que pertenece la cuenta de cobro (constructoras).
  projectId    String?
  /// Documento del que sale (cotización → pedido → cuenta; venta → nota crédito).
  sourceDocumentId String?
  /// Qué lo originó al cobrar: SALE (mostrador), TICKET_SALE, MEMBERSHIP… y su id.
  originType   String?
  originId     String?
  /// Cobro que lo generó (ventas registradas al cobrar).
  paymentId    String?
  /// Resolución de numeración con la que se numeró y su prefijo (vacío = consecutivo simple).
  resolutionId String?
  prefix       String?
  /// Retenciones que practica quien paga (retefuente, reteIVA…): total y detalle por concepto.
  withholdingTotal Decimal    @default(0)
  withholdings Json?
  /// Lo abonado a una cuenta de cobro emitida (cartera). El saldo es total − paidTotal.
  paidTotal    Decimal       @default(0)
  /// Propina de una venta de mostrador (no es ingreso: se cobra aparte del total).
  tipTotal     Decimal       @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    temporal.updatedAt()
  lines        InvoiceLine[]

  @@unique([tenantId, kind, number])
  @@index([tenantId])
  @@index([tenantId, issueDate])
  @@index([sourceDocumentId])
  @@rls
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Decimal
  unitPrice   Decimal
  /// Descuento e impuesto de la línea en % (0 = sin descuento / exenta).
  discountPct Decimal @default(0)
  taxRatePct  Decimal @default(0)
  total       Decimal

  @@index([invoiceId])
  @@rls
}

/// Bodega o punto de almacenamiento. Una es la predeterminada («Principal»).
model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  address   String?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  levels    StockLevel[]
  movements StockMovement[]
  purchaseOrders PurchaseOrder[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  counts         StockCount[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@rls
}

/// Existencias de un producto (o variante) en una bodega, con su costo promedio.
/// `Product.stock` es la suma de las bodegas (se mantiene para las pantallas actuales).
model StockLevel {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0)
  /// Costo promedio ponderado por unidad.
  avgCost     Decimal  @default(0)
  /// variantId o "" (sin variante): permite una restricción única normal, sin índices parciales.
  variantKey  String   @default("")
  updatedAt   temporal.updatedAt()

  @@unique([warehouseId, productId, variantKey])
  @@index([tenantId, productId])
  @@rls
}

/// Orden de compra a un proveedor (tercero con rol SUPPLIER). Al recibir la mercancía
/// entra al inventario con su costo por el servicio de inventario.
model PurchaseOrder {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Consecutivo por negocio (OC-0001).
  number          Int
  supplierPartyId String
  supplier        Party    @relation(fields: [supplierPartyId], references: [id], onDelete: Restrict)
  /// Bodega a la que entra la mercancía.
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELED
  status          String   @default("DRAFT")
  expectedDate    String?
  subtotal        Decimal  @default(0)
  taxTotal        Decimal  @default(0)
  total           Decimal  @default(0)
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       temporal.updatedAt()
  lines           PurchaseOrderLine[]
  invoices        SupplierInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@rls
}

model PurchaseOrderLine {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId        String?
  quantity         Int
  receivedQuantity Int      @default(0)
  /// Costo por unidad SIN impuesto: es el que entra al costo promedio.
  unitCost         Decimal
  taxRatePct       Decimal  @default(0)

  @@index([orderId])
  @@rls
}

/// Traslado de mercancía entre dos bodegas. Sale de una y entra a la otra al costo
/// promedio de la bodega de origen, en la misma transacción (por el servicio de inventario).
model StockTransfer {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Consecutivo por negocio (TR-0001).
  number          Int
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  note            String?
  createdById     String?
  createdAt       DateTime @default(now())
  lines           StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
  @@rls
}

model StockTransferLine {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  quantity    Int
  /// Costo unitario con el que pasó (el promedio de la bodega de origen).
  unitCost    Decimal

  @@index([transferId])
  @@rls
}

/// Conteo físico de una bodega. Se toma una foto de lo esperado; se anota lo contado;
/// al cerrarlo, cada diferencia genera su ajuste en el kardex con el motivo.
model StockCount {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Consecutivo por negocio (CT-0001).
  number       Int
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  /// DRAFT | COMPLETED | CANCELED
  status       String   @default("DRAFT")
  /// Motivo de los ajustes (obligatorio si hay diferencias).
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?
  lines        StockCountLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@rls
}

model StockCountLine {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Lo que decía el sistema al empezar el conteo.
  expected   Int
  /// Lo que se contó (null = aún no contado).
  counted    Int?
  /// Diferencia aplicada al cerrar (contado − esperado).
  adjustment Int?

  @@index([countId])
  @@rls
}

/// Terminal de punto de venta: una caja y una bodega desde donde se vende. Cada cajero abre su turno en ella.
model PosTerminal {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  boxId       String
  warehouseId String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@rls
}

/// Pedido de la tienda en línea (mini-sitio): el cliente deja sus datos y el pedido espera el pago por el enlace de cobro
/// (o la confirmación manual de una transferencia). Al pagarse, descuenta existencias y deja su documento de venta.
model StoreOrder {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Consecutivo por negocio (T-0001).
  number             Int
  /// PENDING_PAYMENT | PAID | CANCELED | ABANDONED
  status             String    @default("PENDING_PAYMENT")
  customerName       String
  phone              String
  email              String?
  address            String?
  city               String?
  notes              String?
  total              Decimal
  /// Cobro en línea del pedido (su enlace y su estado oficial).
  intentId           String?
  /// Documento de venta que deja al pagarse.
  documentId         String?
  /// Aviso para revisar a mano (p. ej. se pagó sin existencias suficientes).
  review             String?
  /// De dónde llegó el cliente: { source, medium, campaign } (UTM).
  origin             Json?
  paidAt             DateTime?
  abandonedNotifiedAt DateTime?
  createdAt          DateTime  @default(now())
  lines              StoreOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@rls
}

model StoreOrderLine {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  quantity  Int
  unitPrice Decimal
  taxRatePct Decimal   @default(0)

  @@index([orderId])
  @@rls
}
