// use prisma-8

model Payment {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  membershipId  String?
  membership    Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  amount        Decimal
  status        PaymentStatus   @default(PENDING)
  provider      PaymentProvider @default(CASH)
  providerRefId String?         @unique
  description   String?
  /// Recibo consecutivo del negocio (R-000123).
  receiptNumber Int?
  /// Anulación con motivo (el pago no se borra).
  voidedAt      DateTime?
  voidReason    String?
  notes         String?
  /// Qué pagó: MEMBERSHIP, INVOICE, TOUR_BOOKING, TICKET_SALE, PROJECT, SALE.
  sourceType    String?
  sourceId      String?
  /// Sesión de caja en la que entró (si fue en efectivo).
  cashSessionId String?
  invoiceId     String?
  createdAt     DateTime        @default(now())
  updatedAt     temporal.updatedAt()

  @@index([tenantId])
  @@index([providerRefId])
  @@index([membershipId])
  @@unique([tenantId, receiptNumber])
  @@rls
}

model Expense {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount      Decimal
  category    String
  description String
  date        DateTime @default(now())
  supplier      String?
  /// CASH (caja menor) | BANK | CARD
  paidFrom      String    @default("BANK")
  voidedAt      DateTime?
  voidReason    String?
  cashSessionId String?
  /// Obra a la que se carga el gasto (constructoras).
  projectId     String?
  createdById   String?
  createdAt   DateTime @default(now())
  updatedAt   temporal.updatedAt()

  @@index([tenantId])
  @@rls
}

/// Caja menor: un fondo fijo con responsable.
model CashBox {
  id                String   @id @default(uuid())
  tenantId          String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  fundAmount        Decimal  @default(0)
  responsibleUserId String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         temporal.updatedAt()
  sessions          CashSession[]

  @@index([tenantId])
  @@rls
}

/// Turno de caja: apertura, movimientos y cierre con arqueo.
model CashSession {
  id             String   @id @default(uuid())
  tenantId       String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  boxId          String
  box            CashBox  @relation(fields: [boxId], references: [id], onDelete: Cascade)
  openedAt       DateTime @default(now())
  openedById     String
  openingAmount  Decimal
  closedAt       DateTime?
  closedById     String?
  expectedAmount Decimal?
  countedAmount  Decimal?
  difference     Decimal?
  closingNotes   String?
  /// Terminal de punto de venta en la que se abrió el turno (vacío = caja sin terminal).
  terminalId     String?
  movements      CashMovement[]

  @@index([tenantId, boxId])
  @@rls
}

model CashMovement {
  id          String           @id @default(uuid())
  tenantId    String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId   String
  session     CashSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        CashMovementKind
  amount      Decimal
  description String
  /// Quién recibe el vale.
  beneficiary String?
  paymentId   String?
  expenseId   String?
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([sessionId])

  @@index([tenantId])
  @@rls
}

/// Factura que el proveedor entrega por una compra. Es el insumo de las cuentas por pagar (PR-14).
model SupplierInvoice {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierPartyId String
  supplier        Party    @relation(fields: [supplierPartyId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  /// Número que trae la factura del proveedor.
  number          String
  issueDate       String
  dueDate         String?
  subtotal        Decimal
  taxTotal        Decimal  @default(0)
  total           Decimal
  /// REGISTERED | PAID | VOID
  status          String   @default("REGISTERED")
  /// CUFE de la factura electrónica, si la trae.
  cufe            String?
  /// Lo ya pagado al proveedor (cartera por pagar). El saldo es total − paidTotal.
  paidTotal       Decimal  @default(0)
  payments        SupplierPayment[]
  createdAt       DateTime @default(now())

  @@unique([tenantId, supplierPartyId, number])
  @@index([tenantId, dueDate])
  @@rls
}

/// Impuesto o retención parametrizable del negocio, con vigencia: el que aplica en una
/// fecha es el vigente ese día (IVA 19 %, IVA 5 %, impoconsumo, retefuente, reteIVA, reteICA).
model TaxRate {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Clave estable del concepto (IVA_19, RETEFUENTE_SERVICIOS…): varias vigencias comparten código.
  code      String
  name      String
  /// IVA | IMPOCONSUMO | RETEFUENTE | RETEIVA | RETEICA
  kind      String
  ratePct   Decimal
  /// Retenciones: solo se practican si la base llega a este valor (0 = siempre).
  minBase   Decimal   @default(0)
  validFrom DateTime
  validTo   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([tenantId, code])
  @@index([tenantId, kind])
  @@rls
}

/// Resolución de numeración autorizada (DIAN u otra): rango con prefijo y vigencia para un
/// tipo de documento. El consecutivo sale de aquí mientras esté activa; al agotarse avisa.
model NumberingResolution {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Tipo de documento comercial al que aplica (SALE, BILL, RECEIPT, CREDIT_NOTE…).
  documentKind     String
  prefix           String    @default("")
  /// Número de la resolución (ej. 18760000001) y su fecha de expedición.
  resolutionNumber String
  rangeFrom        Int
  rangeTo          Int
  /// Próximo número por entregar (rangeFrom al crearla, o el siguiente al último ya usado).
  nextNumber       Int
  validFrom        DateTime
  validTo          DateTime
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([tenantId, documentKind])
  @@rls
}

/// Pago (o abono) a una factura de proveedor. Baja el saldo de la cartera por pagar en la
/// misma transacción que lo registra.
model SupplierPayment {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  amount            Decimal
  method            String
  note              String?
  createdById       String?
  createdAt         DateTime        @default(now())

  @@index([tenantId, supplierInvoiceId])
  @@rls
}

/// Intención de cobro en línea: lo que se le pide pagar a alguien (link, botón o QR). Solo se
/// vuelve ingreso cuando el estado oficial llega (webhook del proveedor o confirmación manual con
/// evidencia); confirmar dos veces el mismo cobro es imposible.
model PaymentIntent {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Código público del enlace (`/pay/<reference>`): imposible de adivinar, único en toda la plataforma.
  reference     String   @unique
  amount        Decimal
  description   String
  /// PENDING | PAID | EXPIRED | FAILED | CANCELED
  status        String   @default("PENDING")
  /// LINK | QR
  channel       String   @default("LINK")
  provider      String   @default("sandbox")
  customerId    String?
  /// Cuenta de cobro que paga (el cobro baja su saldo).
  invoiceId     String?
  expiresAt     DateTime
  paidAt        DateTime?
  /// Cómo se confirmó: PROVIDER (webhook) | MANUAL (transferencia con evidencia).
  confirmedBy   String?
  evidence      String?
  providerRefId String?
  paymentId     String?
  refundedTotal Decimal  @default(0)
  createdById   String?
  createdAt     DateTime @default(now())
  refunds       PaymentRefund[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@rls
}

/// Reembolso total o parcial de un cobro en línea.
model PaymentRefund {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  intentId    String
  intent      PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  amount      Decimal
  reason      String
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([tenantId, intentId])
  @@rls
}

/// Conciliación diaria: lo que reporta el proveedor contra lo que NEXUS confirmó ese día.
model ReconciliationRun {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider    String
  /// AAAA-MM-DD (hora de Colombia).
  day         String
  expected    Decimal
  reported    Decimal
  /// Detalle de lo que no cuadra: [{ kind, externalId, expected, reported }].
  differences Json
  matched     Int
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, day])
  @@rls
}

/// Documento fiscal electrónico de una venta, nota o compra a no obligado (documento soporte). NEXUS arma el
/// contenido y lo entrega a un proveedor tecnológico detrás de un puerto; no firma ni emite por su cuenta. Vender
/// nunca se bloquea: si el proveedor no está, el documento espera en PENDING_PROVIDER.
model FiscalDocument {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Documento comercial del que sale (único: uno por venta/nota).
  invoiceId         String?
  /// Factura de proveedor, cuando es un documento soporte.
  supplierInvoiceId String?
  /// INVOICE | CREDIT_NOTE | DEBIT_NOTE | SUPPORT_DOCUMENT
  kind              String
  /// PENDING_PROVIDER | SUBMITTED | ACCEPTED | REJECTED
  status            String   @default("PENDING_PROVIDER")
  provider          String?
  providerRef       String?
  cufe              String?
  rejectReason      String?
  /// Foto del emisor, el adquirente, las líneas y los totales al momento de emitir.
  payload           Json
  attempts          Int      @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         temporal.updatedAt()

  @@unique([tenantId, invoiceId])
  @@unique([tenantId, supplierInvoiceId])
  @@index([tenantId, status])
  @@rls
}

/// Cuenta del plan único de cuentas (PUC) del negocio. Se siembra con la plantilla colombiana y se ajusta con el contador.
model Account {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Código numérico (1105, 110505…). Un código identifica UNA cuenta por negocio.
  code       String
  name       String
  /// ASSET | LIABILITY | EQUITY | INCOME | EXPENSE | COST
  type       String
  /// D (débito) | C (crédito): el lado en que normalmente aumenta.
  nature     String
  /// Solo las cuentas de movimiento (auxiliares) reciben asientos; las demás agrupan.
  postable   Boolean  @default(true)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([tenantId, code])
  @@rls
}

/// Mes contable. Un mes cerrado no admite asientos nuevos ni cambios (se aplica en el motor contable).
model AccountingPeriod {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  /// OPEN | CLOSED
  status      String    @default("OPEN")
  closedAt    DateTime?
  closedById  String?
  reopenedAt  DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  @@unique([tenantId, year, month])
  @@rls
}

/// Regla que dice qué asiento genera cada hecho del negocio (venta, costo, compra, cobro…). Se pueden ver y desactivar.
model AccountingRule {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Hecho que la dispara: SALE | SALE_COST | CREDIT_NOTE | PURCHASE_RECEIVED | PAYMENT_RECEIVED | EXPENSE_PAID …
  event     String
  name      String
  /// [{ side: "D"|"C", account: "1105", amount: "total"|"subtotal"|"tax"|"cost"|"payment"|"withholding", label }]
  lines     Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, event])
  @@rls
}

/// Centro de costo o sucursal: dimensión analítica de cada asiento.
model CostCenter {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  /// CENTER | BRANCH
  kind      String   @default("CENTER")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@rls
}

/// Asiento contable de partida doble. El libro mayor es de solo agregar: un asiento NO se edita ni se borra; se corrige
/// con otro asiento que lo reversa. Cada asiento encadena el sello (hash) del anterior para detectar cualquier alteración.
model JournalEntry {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Consecutivo por negocio.
  number       Int
  /// Fecha contable AAAA-MM-DD (define el período).
  date         String
  description  String
  /// Regla o hecho que lo generó (SALE, PAYMENT_RECEIVED, MANUAL, REVERSAL…).
  event        String
  /// DOCUMENT | PAYMENT | STOCK | MANUAL: de qué sale, para trazarlo y reversarlo.
  sourceType   String
  sourceId     String?
  /// Si este asiento reversa a otro.
  reversalOfId String?
  /// Sello: SHA-256 de (sello anterior + contenido). Cadena que hace evidente cualquier cambio.
  hash         String
  createdById  String?
  createdAt    DateTime @default(now())
  lines        JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, sourceType, sourceId])
  @@rls
}

model JournalLine {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId      String
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountCode  String
  debit        Decimal      @default(0)
  credit       Decimal      @default(0)
  label        String?
  /// Dimensiones analíticas: tercero y centro de costo de cada línea.
  partyId      String?
  costCenterId String?

  @@index([tenantId, accountCode])
  @@index([entryId])
  @@rls
}
