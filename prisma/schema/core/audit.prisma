// use prisma-8

/// Registro de auditoría de acciones privilegiadas del SuperAdmin
/// (suspensión, activación, módulos, exportación, impersonación). No se
/// relaciona por FK con Tenant a propósito: la auditoría debe sobrevivir al
/// borrado del negocio. NUNCA guarda secretos ni tokens.
///
/// Campos:
/// - `actorId`: Clerk user id del SuperAdmin actor (no expone datos sensibles).
/// - `action`: Acción auditada (string controlado por el código, no un enum: las migraciones de
///   enum en Prisma 8 son frágiles y aquí no aportan valor).
/// - `targetTenantId`: Negocio objetivo (puede ser null en acciones globales como exportar).
/// - `metadata`: Metadatos serializables (motivo, módulos, filas exportadas…). Sin secretos.
/// - `actorType`: Quién actuó: USER | API_KEY | AGENT | AUTOMATION | SYSTEM.
/// - `apiKeyId`: Llave de API que ejecutó la acción (si fue por API/MCP).
/// - `requestId`: Identificador de la petición (el mismo de `X-Request-Id`).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorEmail String?
  action     String
  targetTenantId   String?
  targetTenantName String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actorType  String   @default("USER")
  apiKeyId   String?
  requestId  String?

  @@index([createdAt])
  @@index([targetTenantId])
  @@index([actorId])
  @@index([apiKeyId])
  @@rls
}
