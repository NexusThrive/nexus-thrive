{
  "name": "NEXUS · Resumen diario del negocio",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 20 * * *"
            }
          ]
        }
      },
      "name": "Todos los días 8 pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const NEXUS_URL = \"https://TU-DOMINIO.com\"; // sin barra final\nreturn [{ json: { url: NEXUS_URL + \"/api/v1/finance/summary?days=1\" } }];"
      },
      "name": "Preparar consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Pedir resumen a NEXUS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": null,
          "name": "NEXUS llave de API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json.data;\nconst money = (v) => \"$\" + Number(v).toLocaleString(\"es-CO\");\nconst c = d.current, p = d.previous;\nconst delta = p.income > 0 ? Math.round(((c.income - p.income) / p.income) * 100) : null;\nconst text = \"📊 Resumen de hoy\\n\" +\n  \"Ingresos: \" + money(c.income) + (delta === null ? \"\" : \" (\" + (delta >= 0 ? \"+\" : \"\") + delta + \"% vs. ayer)\") + \"\\n\" +\n  \"Gastos: \" + money(c.expenses) + \"\\n\" +\n  \"Balance: \" + money(c.balance) + \"\\n\" +\n  \"Movimientos: \" + c.count;\nreturn [{ json: { text } }];"
      },
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "TU_CHAT_ID",
        "text": "={{ $json.text }}",
        "additionalFields": {}
      },
      "name": "Avisarme por Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1140,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": null,
          "name": "Telegram"
        }
      }
    }
  ],
  "connections": {
    "Todos los días 8 pm": {
      "main": [
        [
          {
            "node": "Preparar consulta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar consulta": {
      "main": [
        [
          {
            "node": "Pedir resumen a NEXUS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pedir resumen a NEXUS": {
      "main": [
        [
          {
            "node": "Armar mensaje",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar mensaje": {
      "main": [
        [
          {
            "node": "Avisarme por Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Bogota"
  },
  "active": false
}