{
  "version": 1,
  "descripcion": "Clasificación de lib/ por capa de Nexus V2 (E0). La comprueba scripts/check-layers.mjs. No mueve archivos: solo declara a qué capa pertenece cada carpeta. Aprobado D-1: la organización física se mantiene.",
  "layers": {
    "foundation": { "mayImport": [], "descripcion": "Utilidades y acceso a la base. No depende de nada de Nexus." },
    "core": { "mayImport": ["foundation"], "descripcion": "Identidad, organizaciones, tenant, permisos, planes, terceros, archivos, API de operaciones." },
    "business": { "mayImport": ["foundation", "core"], "descripcion": "Capacidades empresariales generales: clientes, catálogo, inventario, ventas, compras, POS, tienda." },
    "finance": { "mayImport": ["foundation", "core", "business"], "descripcion": "Pagos, caja, impuestos, contabilidad, cartera." },
    "integrations": { "mayImport": ["foundation", "core", "business", "finance"], "descripcion": "Puertos y adaptadores hacia proveedores y superficies externas (API, MCP, Google, facturación electrónica)." },
    "automation": { "mayImport": ["foundation", "core"], "descripcion": "Eventos, outbox, webhooks internos y funciones automáticas." },
    "platform": { "mayImport": ["foundation", "core", "business", "finance", "integrations", "automation"], "descripcion": "Operación global de Nexus como SaaS (Operations Center). No es un segundo Core." },
    "industry": { "mayImport": ["foundation", "core", "business", "finance", "integrations", "automation"], "descripcion": "Extensiones sectoriales. Cada industria solo puede importarse a sí misma." },
    "experience": { "mayImport": ["foundation", "core", "business", "finance", "integrations", "automation", "platform", "industry"], "descripcion": "Navegación, onboarding, dashboard, presencia, sitio y utilidades de interfaz." }
