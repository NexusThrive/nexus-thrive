#!/usr/bin/env bash
# Vigila el espejo de GitHub y reintenta cuando queda en error.
#
# GitLab ya sincroniza el espejo solo: en cada push (PostReceive) y también en
# cada merge, que pasa por el mismo hook. No hace falta empujar por cambios de
# refs. Lo que este script cubre es el fallo: si el espejo queda en `failed`
# (token caducado, error de red, push rechazado), nadie lo reintenta hasta que
# alguien pulsa *Update now* en GitLab. Aquí se reintenta cada 5 minutos.
#
# Lo ejecuta nexus-mirror-sync.timer (systemd de usuario, cada minuto).
# Documentación: docs/flujo-gitlab-github.md §5
set -uo pipefail

GITLAB_URL="${GITLAB_URL:-http://100.116.222.50:8929}"
PROJECT_ID="${PROJECT_ID:-1}"
MIRROR_ID="${MIRROR_ID:-1}"
TOKEN_FILE="${TOKEN_FILE:-$HOME/.secrets/gitlab-mirror-sync-token}"
RETRY_AFTER="${RETRY_AFTER:-300}" # segundos entre reintentos

log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

if [ ! -r "$TOKEN_FILE" ]; then
  log "ERROR: no se puede leer $TOKEN_FILE"
  exit 1
fi
TOKEN="$(cat "$TOKEN_FILE")"

api() { curl -fsS --max-time 20 -H "PRIVATE-TOKEN: $TOKEN" "$@"; }

# Imprime "estado<TAB>inicio<TAB>error" del espejo.
mirror_state() {
  api "$GITLAB_URL/api/v4/projects/$PROJECT_ID/remote_mirrors" | python3 -c '
import json, sys

mirror_id = int(sys.argv[1])
try:
    mirrors = json.load(sys.stdin)
except Exception:
    sys.exit(2)

mirror = next((m for m in mirrors if m.get("id") == mirror_id), None)
if mirror is None:
    sys.exit(3)

print("\t".join([
    mirror.get("update_status") or "",
    mirror.get("last_update_started_at") or "",
    (mirror.get("last_error") or "").replace("\t", " ").replace("\n", " "),
]))
' "$MIRROR_ID"
}

if ! state="$(mirror_state)"; then
  log "ERROR: no se pudo consultar el espejo en la API"
  exit 1
fi
IFS=$'\t' read -r status started last_error <<<"$state"

case "$status" in
  failed | not_attempted | none) ;;
  *) exit 0 ;; # sano o en curso: nada que hacer
esac

# No martillear: si el último intento empezó hace menos de RETRY_AFTER, esperar.
# FORCE=1 salta la espera (para reintentar a mano tras arreglar la credencial).
if [ "${FORCE:-0}" != "1" ] && [ -n "$started" ]; then
  edad=$(( $(date -u +%s) - $(date -u -d "$started" +%s) ))
  if [ "$edad" -lt "$RETRY_AFTER" ]; then
    exit 0
  fi
fi

if api -X POST -o /dev/null -w '%{http_code}' \
    "$GITLAB_URL/api/v4/projects/$PROJECT_ID/remote_mirrors/$MIRROR_ID/sync" |
    grep -qx '204'; then
  log "el espejo está en '$status'${last_error:+ ($last_error)}: sync pedido"
else
  log "ERROR: la API rechazó la sincronización (estado '$status')"
  exit 1
fi
