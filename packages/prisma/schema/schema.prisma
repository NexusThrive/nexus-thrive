// ============================================================
// Schema base — Prisma multi-file (prismaSchemaFolder)
//
// NEXUS se reparte en DOS niveles: el NÚCLEO y los MÓDULOS.
//
//   schema.prisma          → datasource, generator, enums globales
//   core/
//     identidad.prisma     → EL NÚCLEO: Organization, Member, Module,
//                            OrganizationModule, Plantilla, PlantillaModulo
//   modulos/
//     clientes.prisma      → Cliente
//     membresias.prisma    → Membresia + EstadoMembresia (Eje B: la membresía
//                            es lo gym-específico; el modelo pertenece al
//                            módulo clientes, no es un módulo del catálogo)
//     planes.prisma        → Plan
//     pagos.prisma         → Pago
//     gastos.prisma        → Gasto
//     caja-menor.prisma    → CajaCategoria, MovimientoCaja
//
// INVARIANTE — un archivo en `modulos/` es UN MÓDULO del catálogo, y su
// nombre es su `modules.slug`. El mismo slug aparece en cuatro lugares:
//   schema/modulos/<slug>.prisma  ·  modules.slug  ·  /modulos/<slug>  ·  lib/modulos/<slug>/
// EXCEPCIÓN (2026-09-28, Eje B): un módulo puede partir su modelo en más de
// un archivo cuando un dominio se separa (membresias.prisma pertenece al
// módulo clientes); el archivo extra NO es un módulo, y el slug de su módulo
// dueño sigue mandando para rutas y navegación.
// Un módulo NO es de un rubro: es un producto que un negocio contrata. Lo
// que es "de un rubro" vive en CONFIGURACIÓN, nunca en el schema:
//   Plantilla.rubro         → qué rubro recibe este conjunto
//   plantilla_modulos       → qué módulos trae el conjunto (+ su nombre en el menú)
//   Module.sugeridoPara     → a quién se le recomienda
// Un negocio activo un módulo con sus propias filas (todo tiene `orgId`),
// así que dos negocios que contratan el mismo módulo nunca se mezclan.
//
// El NÚCLEO no conoce ningún módulo. Si alguna vez hay que tocar
// core/identidad.prisma para agregar un módulo, es una señal de que algo
// se está acoplando: el módulo va en modulos/, no en el núcleo.
//
// DECISIÓN (PLAN-BASE-NEXUS 2026-09-12): NEXUS es la marca, el Campo
// es taxonomía interna y el Módulo es el producto reutilizable. La
// identidad es GLOBAL: una persona (Member), varias orgs, módulos
// activables por org. Un módulo nuevo NUNCA re-registra usuarios.
// ============================================================
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  // Engine explícito: garantiza copiado del .so en build de Next/pnpm
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums GLOBALES del núcleo ----------
enum Rol {
  ADMIN      // dueño de la organización
  OPERADOR   // tareas diarias (permisos por módulo)
  AUDITOR    // puede aprobar/revisar
}

// ---------- Enums del PORTAL (catálogo de módulos) ----------
/// Taxonomía INTERNA de NEXUS — NUNCA visible para el cliente
enum CampoModulo {
  CORE
  FINANCE
  SERVICES
  PRODUCTIVITY
}

enum EstadoModuloOrg {
  SOLICITADO
  ACTIVO
}

/// Alcance del miembro: USER (normal) | CEO (consola global — solo equipo Nexus)
enum UserScope {
  USER
  CEO
}
