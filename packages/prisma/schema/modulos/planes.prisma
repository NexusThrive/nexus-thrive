// ============================================================
// MÓDULO PLANES — las suscripciones que el negocio le vende a sus
// clientes (ej: Mensual $120.000, Trimestral, Anual).
//
// Archivo = 1 MÓDULO del catálogo (`modules.slug = "planes"`).
// El NÚCLEO no conoce este archivo: cuelga de Organization
// (core/identidad.prisma) y se ACTIVA por organización vía
// OrganizationModule (catálogo global).
//
// Eje B (2026-09-28): `Plan` ya no conoce clientes. La relación pasa por
// `Membresia` (membresias.prisma): `Plan` es genérico ("planes de
// servicio", reutilizables por salones y cualquier negocio) y `Cliente`
// quedó limpio en clientes.prisma.
// ============================================================

/// Plan de suscripción (ej: Mensual $120.000, Trimestral, Anual)
model Plan {
  id           String   @id @default(cuid())
  orgId        String
  nombre       String // "Mensual", "Trimestral", "Anual"
  precio       Decimal  @db.Decimal(12, 2) // en la moneda de la org
  duracionDias Int      @default(30)
  activo       Boolean  @default(true)
  membresias   Membresia[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@map("planes")
}
