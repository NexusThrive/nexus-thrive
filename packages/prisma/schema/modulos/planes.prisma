// ============================================================
// MÓDULO PLANES — las suscripciones que el negocio le vende a sus
// clientes (ej: Mensual $120.000, Trimestral, Anual).
//
// Archivo = 1 MÓDULO del catálogo (`modules.slug = "planes"`).
// El NÚCLEO no conoce este archivo: cuelga de Organization
// (core/identidad.prisma) y se ACTIVA por organización vía
// OrganizationModule (catálogo global).
//
// ⚠️ PENDIENTE (docs/MODELO-DATOS.md § Eje B): un Plan sin Cliente no
// existe, así que `Plan` hoy sigue siendo medio gym ("membresía").
// El plan del doc es sacarlo a una tabla `Membresia { clienteId,
// planId, periodoFin, estado }` para que `Plan` sea genérico
// ("planes de servicio", reutilizables por salones y cualquier
// negocio) y `Cliente` quede limpio. Cuando pase, este archivo pasa
// a `membresias.prisma` y `clientes.prisma` pierde `planId`,
// `estado` y `periodoFin`.
// ============================================================

/// Plan de suscripción (ej: Mensual $120.000, Trimestral, Anual)
model Plan {
  id           String   @id @default(cuid())
  orgId        String
  nombre       String // "Mensual", "Trimestral", "Anual"
  precio       Decimal  @db.Decimal(12, 2) // en la moneda de la org
  duracionDias Int      @default(30)
  activo       Boolean  @default(true)
  clientes     Cliente[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@map("planes")
}
