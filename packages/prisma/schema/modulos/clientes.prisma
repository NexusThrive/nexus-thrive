// ============================================================
// MÓDULO CLIENTES — el registro de personas del negocio.
//
// Archivo = 1 MÓDULO del catálogo (`modules.slug = "clientes"`).
// No es de un rubro: cualquier organización que lo active lo usa.
// El grupo de personas se llama distinto según el rubro — gym "socios",
// restaurante "meseros", museo "visitantes" — y ese nombre sale de
// `plantilla_modulos.nombreMenu`, NO de este archivo.
//
// El NÚCLEO no conoce este archivo: cuelga de Organization
// (core/identidad.prisma) y se ACTIVA por organización vía
// OrganizationModule (catálogo global).
//
// Eje B (2026-09-28): `Cliente` queda GENÉRICO — antes cargaba con
// `planId`, `estado` y `periodoFin` (todo el mundo "gym/membresía"
// pegado al perfil). Esa parte vive ahora en `Membresia`
// (membresias.prisma): un cliente puede tener 0..1 membresía, o no
// tenerla (un salón puede registrar clientes sin plan). El estado y el
// vencimiento ya no son columnas de Cliente: salen de la membresía.
// ============================================================

/// Cliente del negocio con su perfil completo
model Cliente {
  id           String      @id @default(cuid())
  orgId        String
  nombre       String
  documento    String?     // cédula (búsqueda rápida)
  telefono     String?
  email        String?
  fechaNacimiento DateTime?
  fechaIngreso DateTime    @default(now())
  nota         String?     // alergias, lesiones, preferencias
  membresia    Membresia?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([orgId, nombre])
  @@map("clientes")
}
