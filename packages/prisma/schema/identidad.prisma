// ============================================================
// MÓDULO IDENTIDAD — GLOBAL a nivel de datos (multitenancy real)
//
// El NÚCLEO de NEXUS. No conoce módulos verticales: cada módulo
// (ej: gym.prisma) cuelga de Organization desde su propio archivo.
//
// DECISIÓN CLAVE (PLAN-BASE-NEXUS 2026-09-12):
//   Member = la persona (email global). Organization = el negocio.
//   Una persona puede ser miembro de VARIAS orgs.
//   La separación "por módulo" es SOLO de UI: nada se re-registra.
//
// POR QUÉ el catálogo (Module) vive ACÁ:
//   El módulo es un PRODUCTO reutilizable → el catálogo es global.
//   La organización lo ACTIVA (OrganizationModule) cuando le sirve.
// ============================================================

model Organization {
  id          String   @id @default(cuid())
  nombre      String
  slug        String   @unique // identidad amigable para URL (ej: "zonarosa")
  // Perfil del negocio (onboarding) — alimenta recomendación de módulos
  tipoNegocio String?  /// "gimnasio" | "comercio" | "restaurante" | ...
  moneda      String   @default("COP")
  pais        String?  /// código ISO (ej: "CO")
  // Onboarding (base NEXUS 2026-09-12): respuestas del dueño + flag de fin.
  // onboardingCompletadoAt = null → el dueño aún no arma su negocio.
  equipo      String?  /// "solo-yo" | "equipo"
  dolor       String?  /// "cobrar" | "no-perder" | "saber-flujo"
  onboardingCompletadoAt DateTime?
  logoUrl     String?
  rolDefault  Rol      @default(OPERADOR)
  members     Member[]
  modules     OrganizationModule[] // módulos habilitados para este negocio
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

model Member {
  id           String    @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  nombre       String
  email        String   // identidad de login: una persona puede pertenecer a varias orgs
  passwordHash String?  // login real (bcrypt). null = pendiente invitación
  rol          Rol       @default(OPERADOR)
  scope        UserScope @default(USER) // USER | CEO — consola global (futuro)
  activo       Boolean   @default(true) // desactivar ≠ borrar (decisión: nunca se borra identidad)
  // Onboarding POR PERSONA (base NEXUS 2026-09-12): cada usuario nuevo ve la
  // guía hasta completarla. Null = todavía no armó su acceso al negocio.
  onboardingCompletadoAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@unique([email, orgId]) // una persona por org (permite multi-org)
  @@map("members")
}

// ============================================================
// MÓDULOS — catálogo GLOBAL de NEXUS (nivel 1 del producto).
// El cliente solo ve esto + las secciones de cada módulo.
// `campo` es taxonomía INTERNA (Finance/Services/...): invisible al cliente.
// `naturaleza` separa CAPA (horizontal, cualquier negocio) de VERTICAL
//   (plantilla de un rubro: se activa por rubro, ej. Gym → gimnasio).
//   La personalización del onboarding ofrece SOLO capas; los verticales
//   entran como plantilla cuando el rubro coincide.
// ============================================================

enum NaturalezaModulo {
  CAPA
  VERTICAL
}

model Module {
  id          String            @id @default(cuid())
  slug        String            @unique // "clientes" | "caja-menor" | "facturacion" | ...
  nombre      String
  descripcion String
  campo       CampoModulo               // taxonomía INTERNA (invisible al cliente)
  naturaleza  NaturalezaModulo @default(CAPA)
  icono       String?                   // slug del ícono lucide ("dumbbell", "wallet", ...)
  /// Módulo BASE: se activa automáticamente en toda organización al crearla
  /// (ej: "clientes"). No es contratable ni se puede desactivar.
  porDefecto  Boolean           @default(false)
  /// Tipos de negocio para los que se recomienda este módulo
  /// (ej: "gimnasio" → presupuestos para control de gastos de máquinas).
  sugeridoPara String[]          @default([])
  activo      Boolean           @default(true)
  orden       Int               @default(0)
  organizaciones OrganizationModule[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("modules")
}

/// Habilitación de un módulo en un negocio: ACTIVO (se usa) o SOLICITADO (pedido).
model OrganizationModule {
  id         String          @id @default(cuid())
  orgId      String
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  moduleId   String
  module     Module          @relation(fields: [moduleId], references: [id])
  estado     EstadoModuloOrg @default(SOLICITADO)
  activadoAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([orgId, moduleId])
  @@index([orgId])
  @@map("organization_modules")
}
