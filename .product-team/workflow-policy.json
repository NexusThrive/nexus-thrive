{
  "schema_version": 1,
  "pause_file": "docs/ingenieria/PAUSA",
  "max_attempts": 3,
  "default_agent": "senior-engineer",
  "concurrency": {
    "max_active_tasks": 1,
    "same_worktree": false,
    "note": "Dos historias incompatibles nunca comparten árbol de trabajo. La primera versión serializa por repositorio."
  },
  "gates": {
    "lint": {
      "command": "pnpm lint",
      "required": true,
      "timeout_seconds": 600
    },
    "typecheck": {
      "command": "pnpm exec tsc --noEmit",
      "required": true,
      "timeout_seconds": 900
    },
    "test": {
      "command": "TEST_DATABASE_URL= pnpm test",
      "required": true,
      "timeout_seconds": 1800
    },
    "build": {
      "command": "pnpm build",
      "required": false,
      "timeout_seconds": 1800
    }
  },
  "routing": [
    {
      "agent": "storybook-engineer",
