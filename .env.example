# Copia este archivo a .env y completa los valores (nunca subas .env al repo).
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Proxy de la Frontend API de Clerk (opcional). Solo si el dominio de Clerk no
# es alcanzable: sirve el script de ClerkJS desde nuestro propio dominio
# ({base}/__clerk/...) y el middleware lo reenvía a Clerk.
# Antes de activarlo, configura en el Dashboard de Clerk el proxy del dominio
# de producción: https://<tu-dominio>/__clerk
NEXT_PUBLIC_CLERK_PROXY_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
# URL pública de la app para enlaces compartibles (recibos, encuestas, WhatsApp).
# En producción con dominio propio: https://tudominio.com
NEXT_PUBLIC_APP_URL=
# WhatsApp de NEXUS para coordinar el pago de los accesos (solo dígitos, con
# prefijo de país). Por defecto 573237453913.
NEXT_PUBLIC_NEXUS_WHATSAPP=
# Firma de los enlaces públicos de recibo (opcional; por defecto usa CLERK_SECRET_KEY).
RECEIPT_LINK_SECRET=
NEXT_TELEMETRY_DISABLED=1
CLERK_TELEMETRY_DISABLED=1
# Vercel Blob: solo servidor. No uses NEXT_PUBLIC_BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Hosts extra del dev server (Tailscale/LAN), separados por coma.
DEV_ALLOWED_ORIGINS=
# Base aparte para pnpm test:integration.
TEST_DATABASE_URL=

# Bandeja del Operations Center (opcional: sin esto, las respuestas se envían a mano con wa.me/mailto)
# WhatsApp Cloud API (Meta) — webhook: /api/webhooks/whatsapp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Correo saliente (Resend) y entrante — webhook: /api/webhooks/email (cabecera x-inbox-secret)
RESEND_API_KEY=
INBOX_EMAIL_FROM=
INBOUND_EMAIL_SECRET=

# Google Maps — desactivado (ahora usamos Photon + Leaflet gratis). No es necesario.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
