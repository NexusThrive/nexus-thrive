# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.produccion

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/migrations

# transcripts de sesión (no se versionan)
/conversations

# contract emitido viejo (el vigente vive en prisma/) y volcado manual de esquema
/generated
/migration.sql

# Storybook
/storybook-static
*storybook.log

# Scripts destructivos y parches sueltos: se guardan fuera del repo
docs/prod-sql/*limpieza*.sql
*.patch

# graphify: grafo de conocimiento generado (graphify update .)
graphify-out/

# Playwright
/test-results
/playwright-report
/blob-report
