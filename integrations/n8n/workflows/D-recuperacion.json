        "jsCode": "const bucket = new Date().toISOString().slice(0, 13); // una ejecución por hora\nreturn [{ json: {\n  event: 'recovery',\n  idempotency_key: `recovery-${bucket}`,\n  title: 'Comprobar tareas interrumpidas',\n  task: null,\n} }];\n"
