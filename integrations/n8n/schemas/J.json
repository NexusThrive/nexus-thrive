{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/n8n/J.json",
  "title": "NEXUS · J · Aprobación de campaña",
  "type": "object",
  "required": [
    "event",
    "idempotency_key",
    "title"
  ],
  "properties": {
    "event": {
      "type": "string",
      "const": "campaign.approval"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "additionalProperties": false
}
