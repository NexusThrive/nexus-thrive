{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/schemas/n8n/A.json",
  "title": "NEXUS · A · Nueva solicitud",
  "type": "object",
  "required": [
    "event",
    "idempotency_key",
    "title"
  ],
  "properties": {
    "event": {
      "type": "string",
      "const": "task.request"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "story": {
          "type": "string"
        },
        "discipline": {
          "type": "string",
          "enum": [
            "engineering",
            "design",
            "documentation",
            "marketing",
            "growth",
            "research"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
