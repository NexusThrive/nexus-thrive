{
  "name": "nexus-thrive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma skills sync || exit 0",
    "test": "vitest run",
    "test:integration": "bash ./test-integration.sh",
    "test:e2e": "storybook build --quiet -o storybook-static && playwright test",
    "verify": "pnpm exec tsc --noEmit && pnpm test --run 2>&1 | tail -3 && pnpm test:integration 2>&1 | tail -3 && pnpm build 2>&1 | grep -E '○|ƒ' | tail -2",
    "release": "bash ./scripts/release.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "docs:progreso": "node scripts/capas-progreso.mjs --write"
  },
